+func nativePlacementFixture(t *testing.T) (*v1.Pod, *v1.Node, *v1alpha2.BindRequest, *v1.ConfigMap, *v1.ConfigMap) {
+	t.Helper()
+	var fixture map[string]json.RawMessage
+	if err := json.Unmarshal([]byte(nativePlacementPythonFixture), &fixture); err != nil {
+		t.Fatal(err)
+	}
+	pod, registry, seed := &v1.Pod{}, &v1.ConfigMap{}, &v1.ConfigMap{}
+	for name, target := range map[string]interface{}{"pod": pod, "pending_registry_configmap": registry, "pending_compiler_seed_configmap": seed} {
+		if err := json.Unmarshal(fixture[name], target); err != nil {
+			t.Fatal(err)
+		}
+	}
+	// The compiler emits a create proposal; the fake API supplies its original UID/RV.
+	registry.UID = "33333333-3333-4333-8333-333333333333"
+	registry.ResourceVersion = "101"
+	_, node, br := nativeTestInputs()
+	br.Namespace = pod.Namespace
+	br.Spec.PodName = pod.Name
+	br.Spec.SelectedNode = node.Name
+	br.Spec.ReceivedResourceType = "Fraction"
+	br.Spec.ReceivedGPU = &v1alpha2.ReceivedGPU{Count: 1, Portion: "0.25"}
+	br.Spec.SelectedFractionalGpuGroups = []v1alpha2.FractionalGpuGroup{{ID: "group", ComputeSharingMode: v1alpha2.GPUComputeSharingModeTimeSlicing}}
+	node.Status.NodeInfo.BootID = "209f8bc9-a478-48e4-925a-6e07ffa56f7a"
+	node.Labels = map[string]string{"nvidia.com/gpu.memory": "40960"}
+	return pod, node, br, registry, seed
+}
