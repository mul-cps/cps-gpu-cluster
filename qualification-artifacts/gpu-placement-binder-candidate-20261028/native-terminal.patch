+func TestInertPlacementRefusesBeforeWritesAndHoldsForeignSelection(t *testing.T) {
+	for _, fault := range []string{"extra-registry-field", "seed-data-drift", "seed-uid-drift", "placement-id-seed-drift", "attempt-seed-drift", "duplicate-candidate", "bad-cap", "zero-ref-version", "nondecimal-ref-version", "zero-gpu", "mixed-candidate-node", "mixed-candidate-epoch", "unbound-hash-as-bound", "foreign-reserved-gpu", "wrong-selected-boot"} {
+		t.Run(fault, func(t *testing.T) {
+			pod, node, br, registry, seed := nativePlacementFixture(t)
+			var doc map[string]interface{}
+			_ = json.Unmarshal([]byte(registry.Data["registry.json"]), &doc)
+			reservation := &nativePlacementReservation{gpu: "GPU-1e6145d5-8ee2-43e2-a0d5-6d345909e8a6"}
