+func TestInertPlacementPythonFixtureAndActualReservedSecondGPU(t *testing.T) {
+	pod, node, br, registry, seed := nativePlacementFixture(t)
+	// Exact existing Python controller-addition allowlists, not compiler fields.
+	pod.Labels["runai-gpu-group"] = "group"
+	pod.Labels["kai.scheduler/subgroup-name"] = "subgroup"
+	pod.Annotations["pod-group-name"] = "pod-group"
+	pod.Annotations["kai.scheduler/numa-placement-predicted"] = "[]"
+	ack := nativeTestACK(pod)
+	ack.Namespace = "cps-compute"
+	binds := 0
+	kube := nativeTestClient(t, pod, node, br, func(*v1.Binding) error { binds++; return nil }, registry, seed, ack)
+	reservation := &nativePlacementReservation{gpu: "GPU-1e6145d5-8ee2-43e2-a0d5-6d345909e8a6"}
+	coord := &nativePlacementTestCoordinator{&nativeTestCoordinator{ack: ack}}
+	coord.prepare = func(snapshot NativeTerminalSnapshot) {
+		if !reflect.DeepEqual(snapshot.BindingState.ReservedGPUIds, []string{reservation.gpu}) || snapshot.Node.UID != node.UID || snapshot.Node.Status.NodeInfo.BootID != node.Status.NodeInfo.BootID {
+			t.Fatal("actual reserved placement state lost")
+		}
+		if snapshot.placementID != "placement-f580d54f2ba0b25123b15b8d2f28b8ab576d85f8b128c2ed04e6d76ddb90" || snapshot.placementAttempt != "22222222-2222-4222-8222-222222222222" {
+			t.Fatalf("protected registry placement identity lost: %q %q", snapshot.placementID, snapshot.placementAttempt)
+		}
+		cm := &v1.ConfigMap{}
+		if err := kube.Get(context.Background(), client.ObjectKey{Namespace: pod.Namespace, Name: pod.Annotations["runai/shared-gpu-configmap"] + "-0"}, cm); err != nil {
+			t.Fatal(err)
+		}
+		if cm.Data["CUDA_DEVICE_MEMORY_LIMIT"] != "10240m" || cm.Data["NVIDIA_VISIBLE_DEVICES"] != "k8s.device-plugin.nvidia.com/gpu="+reservation.gpu {
+			t.Fatalf("actual map/cap differs: %v", cm.Data)
+		}
+	}
+	ps := plugins.New()
+	ps.RegisterPlugin(gpusharing.New(kube, true, false))
+	ps.RegisterPlugin(hamicore.New(kube))
+	binder := NewBinder(kube, reservation, ps)
+	binder.SetNativeTerminal(kube, "cps-compute", coord)
+	if err := binder.Bind(context.Background(), pod, node, br); err != nil {
+		t.Fatal(err)
+	}
+	if binds != 1 || reservation.syncs != 1 || !reflect.DeepEqual(coord.calls, []string{"prepare-placement", "validate", "validate-binding", "bound", "close"}) {
+		t.Fatalf("unexpected exact terminal flow: binds=%d sync=%d calls=%v", binds, reservation.syncs, coord.calls)
+	}
+}
