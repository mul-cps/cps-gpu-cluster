+// Placement proves an inert compiler product before stock reservation/map writes.
+// It is not allocation authority: the coordinator still authenticates the actual
+// selected device, current qualification/epoch, capacity and full final Binding.
+func nativePlacementKeys(value map[string]interface{}, keys ...string) bool {
+	if len(value) != len(keys) {
+		return false
+	}
+	for _, key := range keys {
+		if _, ok := value[key]; !ok {
+			return false
+		}
+	}
+	return true
+}
+func nativePlacementString(value interface{}, pattern string) bool {
+	text, ok := value.(string)
+	return ok && regexp.MustCompile(pattern).MatchString(text)
+}
+
+const nativePlacementUUID = `^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$`
+const nativePlacementSHA = `^sha256:[a-f0-9]{64}$`
+
+func nativePlacementRef(value interface{}, key string) (map[string]interface{}, bool) {
+	ref, ok := value.(map[string]interface{})
+	if !ok || !nativePlacementKeys(ref, "namespace", "name", "uid", "resourceVersion", "data_sha256", "key") || ref["key"] != key {
+		return nil, false
+	}
+	for _, field := range []string{"namespace", "name"} {
+		if !nativePlacementString(ref[field], `^[A-Za-z0-9][A-Za-z0-9._-]{0,252}$`) {
+			return nil, false
+		}
+	}
+	if !nativePlacementString(ref["resourceVersion"], `^[1-9][0-9]*$`) || !nativePlacementString(ref["uid"], nativePlacementUUID) || ref["uid"] == "00000000-0000-0000-0000-000000000000" || !nativePlacementString(ref["data_sha256"], nativePlacementSHA) {
+		return nil, false
+	}
+	return ref, true
+}
