+// Match native_gpu_pending._check_pending_metadata: compiler keys are frozen;
+// only these existing named KAI controller additions may appear afterwards.
+func nativePlacementMetadata(metadata map[string]interface{}, pod *v1.Pod) error {
+	for _, item := range []struct {
+		key       string
+		actual    map[string]string
+		additions map[string]bool
+	}{
+		{"labels", pod.Labels, map[string]bool{"runai-gpu-group": true, "kai.scheduler/subgroup-name": true}},
+		{"annotations", pod.Annotations, map[string]bool{"pod-group-name": true, "received-resource-type": true, "kai.scheduler/numa-placement-predicted": true}},
+	} {
+		compiled, ok := metadata[item.key].(map[string]interface{})
+		if !ok {
+			return fmt.Errorf("string compiler metadata required")
+		}
+		for key, value := range compiled {
+			text, ok := value.(string)
+			actual, present := item.actual[key]
+			if !ok || !present || actual != text {
+				return fmt.Errorf("original compiler metadata changed")
+			}
+		}
+		for key := range item.actual {
+			if _, compiledKey := compiled[key]; !compiledKey && !item.additions[key] {
+				return fmt.Errorf("unexpected controller metadata added")
+			}
+		}
+	}
+	return nil
+}
+
+func (b *Binder) nativePlacementSeed(ctx context.Context, ref map[string]interface{}) (map[string]interface{}, error) {
+	cm := &v1.ConfigMap{}
+	if ref["namespace"] != b.nativeAuthorityNamespace {
+		return nil, fmt.Errorf("compiler seed authority namespace differs")
+	}
+	if err := b.nativeReader.Get(ctx, client.ObjectKey{Namespace: b.nativeAuthorityNamespace, Name: ref["name"].(string)}, cm); err != nil {
+		return nil, err
+	}
+	if cm.Namespace != ref["namespace"] || cm.Name != ref["name"] || string(cm.UID) != ref["uid"] || cm.ResourceVersion != ref["resourceVersion"] || cm.DeletionTimestamp != nil || cm.Immutable == nil || !*cm.Immutable || len(cm.OwnerReferences) != 0 || len(cm.BinaryData) != 0 || len(cm.Data) != 1 {
+		return nil, fmt.Errorf("original immutable compiler seed changed")
+	}
+	digest, err := nativeRegistryHash(cm.Data)
+	if err != nil || "sha256:"+digest != ref["data_sha256"] {
+		return nil, fmt.Errorf("compiler seed data hash differs")
+	}
+	raw, ok := cm.Data["seed.json"]
+	if !ok || len(raw) == 0 || len(raw) > 1048576 {
+		return nil, fmt.Errorf("bounded compiler seed required")
+	}
+	decoder := json.NewDecoder(bytes.NewBufferString(raw))
+	decoder.UseNumber()
+	value, err := nativeJSONValue(decoder)
+	if err != nil {
+		return nil, err
+	}
+	if _, err = decoder.Token(); err != io.EOF {
+		return nil, fmt.Errorf("trailing compiler seed JSON")
+	}
+	seed, ok := value.(map[string]interface{})
+	if !ok {
+		return nil, fmt.Errorf("compiler seed object required")
+	}
+	return seed, nil
+}
