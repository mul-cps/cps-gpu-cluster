+		return nil, fmt.Errorf("closed inert compiler seed required")
+	}
+	for _, key := range []string{"placement_id", "source", "actor", "workspace", "attempt"} {
+		if seed[key] != registry[key] {
+			return nil, fmt.Errorf("compiler seed identity differs")
+		}
+	}
+	admitted, ok := seed["admitted"].(map[string]interface{})
+	if !ok || !nativePlacementKeys(admitted, "apiVersion", "kind", "metadata", "spec") || admitted["apiVersion"] != "v1" || admitted["kind"] != "Pod" {
+		return nil, fmt.Errorf("raw admitted compiler Pod required")
+	}
+	metadata, ok := admitted["metadata"].(map[string]interface{})
+	if !ok || !nativePlacementKeys(metadata, "namespace", "name", "annotations", "labels") || metadata["namespace"] != pod.Namespace || metadata["name"] != pod.Name {
