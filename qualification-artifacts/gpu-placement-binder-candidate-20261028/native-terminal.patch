+			return nil, fmt.Errorf("current inert compiler metadata differs")
+		}
+	}
+	if current.Annotations[NativePendingAnnotation] != nativePlacementPendingProtocol {
+		return nil, fmt.Errorf("inert compiler marker differs")
+	}
+	registry, err := b.nativeProtectedDocument(ctx, "cps-pending-registry-"+string(pod.UID), "registry.json")
+	if err != nil {
+		return nil, err
+	}
+	if !nativePlacementKeys(registry, "protocol", "kind", "pod_uid", "namespace", "name", "source", "actor", "workspace", "attempt", "placement_id", "profile", "policy_hash", "cap_mib", "approval_ref", "placement_candidates", "pending_spec_sha256", "spec_sha256", "capabilities_configmap", "env_configmap", "selection_configmap", "kai_commit", "compiler_seed_ref") || registry["protocol"] != "cps-native-kai-placement/v1" || registry["kind"] != "inert-placement-registry" {
+		return nil, fmt.Errorf("closed inert placement registry required")
+	}
+	source := map[string]string{"jupyterhub": "cps", "cit-jhub": "cit"}[pod.Namespace]
+	prefix := current.Annotations["runai/shared-gpu-configmap"]
+	if source == "" || registry["source"] != source || registry["pod_uid"] != string(pod.UID) || registry["namespace"] != pod.Namespace || registry["name"] != pod.Name || !nativePlacementString(registry["actor"], `^.{1,512}$`) || !nativePlacementString(registry["workspace"], `^.{1,512}$`) || !nativePlacementString(registry["attempt"], nativePlacementUUID) || registry["attempt"] == "00000000-0000-0000-0000-000000000000" || !nativePlacementString(registry["placement_id"], `^placement-[a-f0-9]{60}$`) || !nativePlacementString(registry["policy_hash"], nativePlacementSHA) || !regexp.MustCompile(`^cps-native-[a-f0-9]{32}-shared-gpu$`).MatchString(prefix) || registry["capabilities_configmap"] != prefix+"-0" || registry["env_configmap"] != prefix+"-0-evar" || registry["selection_configmap"] != prefix[:len(prefix)-len("-shared-gpu")]+"-selection" || registry["kai_commit"] != "bdf434e5e9201cccf4e05fad04d814363653f692" {
+		return nil, fmt.Errorf("inert compiler scope/maps differ")
+	}
+	approval, ok := registry["approval_ref"].(map[string]interface{})
+	if !ok || !nativePlacementKeys(approval, "namespace", "name", "uid", "data_sha256", "revision", "policy_hash") || approval["policy_hash"] != registry["policy_hash"] || !nativePlacementString(approval["namespace"], `^[a-z0-9.-]+$`) || !nativePlacementString(approval["name"], `^[a-z0-9.-]+$`) || !nativePlacementString(approval["uid"], nativePlacementUUID) || !nativePlacementString(approval["data_sha256"], nativePlacementSHA) || !nativePlacementString(approval["revision"], nativePlacementSHA) {
+		return nil, fmt.Errorf("typed placement approval reference required")
