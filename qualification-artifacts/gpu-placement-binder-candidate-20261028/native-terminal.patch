+func (b *Binder) nativePlacementSelected(ctx context.Context, pod *v1.Pod, node *v1.Node, bindingState *state.BindingState) (nativePlacementIdentity, error) {
+	identity := nativePlacementIdentity{}
+	devices, err := b.nativePlacementProof(ctx, pod, nil, &identity)
+	if err != nil {
+		return nativePlacementIdentity{}, err
+	}
+	if len(bindingState.ReservedGPUIds) != 1 {
+		return nativePlacementIdentity{}, fmt.Errorf("one actual reserved placement GPU required")
+	}
+	for _, device := range devices {
+		if device["node"] == node.Name && device["node_uid"] == string(node.UID) && device["boot_id"] == node.Status.NodeInfo.BootID && device["gpu_uuid"] == bindingState.ReservedGPUIds[0] {
+			return identity, nil
+		}
+	}
+	return nativePlacementIdentity{}, fmt.Errorf("actual reserved GPU/Node/boot is outside compiler candidate set")
+}
