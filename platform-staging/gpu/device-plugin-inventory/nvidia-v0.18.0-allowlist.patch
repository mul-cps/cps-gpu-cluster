+	config := allowConfig(t, `"allowedGPUUUIDs":["`+qualifiedUUID+`","`+excludedUUID+`"]`)
+	for _, ids := range [][]string{nil, {qualifiedUUID}, {excludedUUID}} {
+		managers, err := rm.NewNVMLResourceManagers(allowInfo{platform: info.PlatformNVML}, allowNVML{}, allowDevices{ids: ids}, config)
+		require.ErrorContains(t, err, "absent")
+		require.Nil(t, managers)
