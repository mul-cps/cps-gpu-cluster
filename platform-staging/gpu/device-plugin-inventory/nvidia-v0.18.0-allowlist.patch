@@ -0,0 +1,45 @@
+package v1
+
+import (
+	"github.com/stretchr/testify/require"
+	"sigs.k8s.io/yaml"
+	"strings"
+	"testing"
+)
+
+func TestAllowedGPUUUIDsRoundTrip(t *testing.T) {
+	for _, value := range []string{"[]", "[GPU-16128952-b438-556a-00bb-93039ee24e56]"} {
+		var config Config
+		require.NoError(t, yaml.Unmarshal([]byte("version: v1\nflags:\n  plugin:\n    allowedGPUUUIDs: "+value+"\n"), &config))
+		data, err := yaml.Marshal(config.Flags)
+		require.NoError(t, err)
+		require.Contains(t, string(data), "allowedGPUUUIDs:")
+		var restored Flags
+		require.NoError(t, yaml.Unmarshal(data, &restored))
+		require.Equal(t, config.Flags, restored)
+	}
+	var config Config
+	data, err := yaml.Marshal(config.Flags)
+	require.NoError(t, err)
+	require.NotContains(t, string(data), "allowedGPUUUIDs")
+}
+
+func TestAllowedGPUUUIDsRejectConfiguredNullAndWrongTypes(t *testing.T) {
+	for _, value := range []string{"null", "", "0", "GPU-16128952-b438-556a-00bb-93039ee24e56", "{}", "[null]", "[1]"} {
+		t.Run(value, func(t *testing.T) {
+			_, err := parseConfigFrom(strings.NewReader("version: v1\nflags:\n  plugin:\n    allowedGPUUUIDs: " + value + "\n"))
+			require.Error(t, err)
+		})
+	}
+	_, err := parseConfigFrom(strings.NewReader("version: v1\nflags:\n  plugin: {}\n"))
+	require.NoError(t, err)
+}
+
+func TestAllowedGPUUUIDsRejectCaseFoldedSelectorAliases(t *testing.T) {
+	for _, key := range []string{"AllowedGPUUUIDs", "allowedgpuuuids", "ALLOWEDGPUUUIDS"} {
+		for _, prefix := range []string{"", "    allowedGPUUUIDs: [GPU-16128952-b438-556a-00bb-93039ee24e56]\n"} {
+			_, err := parseConfigFrom(strings.NewReader("version: v1\nflags:\n  plugin:\n" + prefix + "    " + key + ": null\n"))
+			require.Error(t, err)
+		}
+	}
+}
