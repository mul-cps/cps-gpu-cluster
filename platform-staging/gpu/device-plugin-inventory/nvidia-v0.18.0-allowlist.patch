+	"github.com/stretchr/testify/require"
+	pluginapi "k8s.io/kubelet/pkg/apis/deviceplugin/v1beta1"
+	"testing"
+)
+
+const qualifiedUUID = "GPU-16128952-b438-556a-00bb-93039ee24e56"
+const excludedUUID = "GPU-1e6145d5-8ee2-43e2-a0d5-6d345909e8a6"
+
+type allowInfo struct {
+	info.Interface
+	platform info.Platform
+}
+
+func (i allowInfo) ResolvePlatform() info.Platform { return i.platform }
+
+type allowNVML struct{ nvml.Interface }
+
+func (allowNVML) Init() nvml.Return     { return nvml.SUCCESS }
+func (allowNVML) Shutdown() nvml.Return { return nvml.SUCCESS }
+
+type allowDevice struct {
+	device.Device
+	id  string
+	mig bool
+}
+
+func (d allowDevice) GetUUID() (string, nvml.Return)          { return d.id, nvml.SUCCESS }
+func (d allowDevice) GetName() (string, nvml.Return)          { return "TestGPU", nvml.SUCCESS }
+func (d allowDevice) IsMigEnabled() (bool, error)             { return d.mig, nil }
+func (d allowDevice) GetMinorNumber() (int, nvml.Return)      { return 1, nvml.SUCCESS }
+func (d allowDevice) GetPciInfo() (nvml.PciInfo, nvml.Return) { return nvml.PciInfo{}, nvml.SUCCESS }
+func (d allowDevice) GetMemoryInfo() (nvml.Memory, nvml.Return) {
+	return nvml.Memory{Total: 40960}, nvml.SUCCESS
+}
+func (d allowDevice) GetCudaComputeCapability() (int, int, nvml.Return) { return 8, 0, nvml.SUCCESS }
+
+type allowDevices struct {
+	device.Interface
+	ids []string
+	mig bool
+}
+
+func (d allowDevices) VisitDevices(f func(int, device.Device) error) error {
+	for i, id := range d.ids {
+		if err := f(i, allowDevice{id: id, mig: d.mig}); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+func allowConfig(t *testing.T, selector string) *spec.Config {
+	t.Helper()
+	var config spec.Config
+	require.NoError(t, json.Unmarshal([]byte(`{"flags":{"migStrategy":"none","deviceDiscoveryStrategy":"nvml","plugin":{"deviceIDStrategy":"uuid",`+selector+`}},"resources":{"gpus":[{"pattern":"*","name":"nvidia.com/gpu"}]}}`), &config))
+	return &config
+}
+func TestAllowedGPUUUIDsInventory(t *testing.T) {
+	for _, ids := range [][]string{{excludedUUID, qualifiedUUID}, {qualifiedUUID, excludedUUID}} {
+		config := allowConfig(t, `"allowedGPUUUIDs":["`+qualifiedUUID+`"]`)
+		managers, err := rm.NewNVMLResourceManagers(allowInfo{platform: info.PlatformNVML}, allowNVML{}, allowDevices{ids: ids}, config)
+		require.NoError(t, err)
+		require.Len(t, managers, 1)
+		manager := managers[0]
+		require.Equal(t, spec.ResourceName("nvidia.com/gpu"), manager.Resource())
+		require.Len(t, manager.Devices(), 1)
+		require.True(t, manager.Devices().Contains(qualifiedUUID))
+		plugin := nvidiaDevicePlugin{rm: manager, config: config, deviceListStrategies: spec.DeviceListStrategies{"envvar": true}, stop: make(chan interface{}), health: make(chan *rm.Device)}
+		stream := &allowStream{responses: make(chan *pluginapi.ListAndWatchResponse, 3)}
+		done := make(chan error, 1)
+		go func() { done <- plugin.ListAndWatch(&pluginapi.Empty{}, stream) }()
+		response := <-stream.responses
+		require.Len(t, response.Devices, 1)
+		require.Equal(t, qualifiedUUID, response.Devices[0].ID)
+		plugin.health <- &rm.Device{Device: pluginapi.Device{ID: excludedUUID}}
+		response = <-stream.responses
+		require.Len(t, response.Devices, 1)
+		require.Equal(t, qualifiedUUID, response.Devices[0].ID)
+		close(plugin.stop)
+		require.NoError(t, <-done)
+		_, err = plugin.Allocate(context.Background(), &pluginapi.AllocateRequest{ContainerRequests: []*pluginapi.ContainerAllocateRequest{{DevicesIDs: []string{excludedUUID}}}})
+		require.ErrorContains(t, err, "unknown device")
+		allocated, err := plugin.Allocate(context.Background(), &pluginapi.AllocateRequest{ContainerRequests: []*pluginapi.ContainerAllocateRequest{{DevicesIDs: []string{qualifiedUUID}}}})
+		require.NoError(t, err)
+		require.Equal(t, qualifiedUUID, allocated.ContainerResponses[0].Envs["NVIDIA_VISIBLE_DEVICES"])
+		plugin.deviceListStrategies = spec.DeviceListStrategies{"cdi-cri": true}
+		plugin.cdiHandler = &cdi.InterfaceMock{QualifiedNameFunc: func(class, id string) string { return "nvidia.com/" + class + "=" + id }}
+		allocated, err = plugin.Allocate(context.Background(), &pluginapi.AllocateRequest{ContainerRequests: []*pluginapi.ContainerAllocateRequest{{DevicesIDs: []string{qualifiedUUID}}}})
+		require.NoError(t, err)
+		require.Equal(t, []*pluginapi.CDIDevice{{Name: "nvidia.com/gpu=" + qualifiedUUID}}, allocated.ContainerResponses[0].CDIDevices)
+	}
+}
+
+type allowStream struct {
+	pluginapi.DevicePlugin_ListAndWatchServer
+	responses chan *pluginapi.ListAndWatchResponse
+}
+
+func (s *allowStream) Send(r *pluginapi.ListAndWatchResponse) error { s.responses <- r; return nil }
+func TestAllowedGPUUUIDsFailClosed(t *testing.T) {
+	for _, selector := range []string{`"allowedGPUUUIDs":[]`, `"allowedGPUUUIDs":["0"]`, `"allowedGPUUUIDs":["GPU-16128952-b438-556a-00bb-93039ee24e56","GPU-16128952-b438-556a-00bb-93039ee24e56"]`, `"allowedGPUUUIDs":["GPU-00000000-0000-0000-0000-000000000000"]`} {
+		t.Run(selector, func(t *testing.T) {
+			_, err := rm.NewNVMLResourceManagers(allowInfo{platform: info.PlatformNVML}, allowNVML{}, allowDevices{ids: []string{qualifiedUUID, excludedUUID}}, allowConfig(t, selector))
+			require.Error(t, err)
+		})
+	}
+}
+func TestAllowedGPUUUIDsUnsetPreservesInventory(t *testing.T) {
+	managers, err := rm.NewNVMLResourceManagers(allowInfo{platform: info.PlatformNVML}, allowNVML{}, allowDevices{ids: []string{qualifiedUUID, excludedUUID}}, allowConfig(t, `"passDeviceSpecs":false`))
+	require.NoError(t, err)
+	require.Len(t, managers[0].Devices(), 2)
+}
+func TestAllowedGPUUUIDsUnsupportedModes(t *testing.T) {
+	for _, mode := range []string{"mig", "physical-mig", "timeslicing", "mps", "wsl", "tegra", "discovery"} {
+		t.Run(mode, func(t *testing.T) {
+			config := allowConfig(t, `"allowedGPUUUIDs":["`+qualifiedUUID+`"]`)
+			platform := info.PlatformNVML
+			devices := allowDevices{ids: []string{qualifiedUUID}}
+			switch mode {
+			case "mig":
+				config.Flags.MigStrategy = ptr("mixed")
+			case "physical-mig":
+				devices.mig = true
+			case "timeslicing":
+				config.Sharing.TimeSlicing.Resources = []spec.ReplicatedResource{{Name: "nvidia.com/gpu", Replicas: 2}}
+			case "mps":
+				config.Sharing.MPS = &spec.ReplicatedResources{}
+			case "wsl":
+				platform = info.PlatformWSL
+			case "tegra":
+				platform = info.PlatformTegra
+			case "discovery":
+				config.Flags.DeviceDiscoveryStrategy = ptr("tegra")
+			}
+			_, err := rm.NewNVMLResourceManagers(allowInfo{platform: platform}, allowNVML{}, devices, config)
+			require.Error(t, err)
+		})
+	}
+}
+
+func (d allowDevice) GetMigDevices() ([]device.MigDevice, error) { return nil, nil }
+func (d allowDevices) VisitMigDevices(f func(int, device.Device, int, device.MigDevice) error) error {
+	return nil
+}
+
+type allowFailedNVML struct{ nvml.Interface }
+
+func (allowFailedNVML) Init() nvml.Return { return nvml.ERROR_UNKNOWN }
+func TestAllowedGPUUUIDsInitFailureNeverFallsBack(t *testing.T) {
+	config := allowConfig(t, `"allowedGPUUUIDs":["`+qualifiedUUID+`"]`)
+	o := options{infolib: allowInfo{platform: info.PlatformNVML}, nvmllib: allowFailedNVML{}, config: config, failOnInitError: false}
+	managers, err := o.getResourceManagers()
