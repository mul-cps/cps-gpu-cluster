+// ValidateAllowedGPUUUIDs rejects unsupported allowlist configurations before discovery.
+// An unset selector retains the upstream discovery and allocation behavior.
+func ValidateAllowedGPUUUIDs(infolib info.Interface, config *spec.Config) error {
+	if config.Flags.Plugin == nil || config.Flags.Plugin.AllowedGPUUUIDs == nil {
+		return nil
+	}
+	ids := *config.Flags.Plugin.AllowedGPUUUIDs
+	if len(ids) == 0 {
+		return fmt.Errorf("allowedGPUUUIDs must not be empty when configured")
+	}
+	canonical := regexp.MustCompile(`^GPU-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$`)
+	seen := make(map[string]bool)
+	for _, id := range ids {
+		if !canonical.MatchString(id) || seen[id] {
+			return fmt.Errorf("allowedGPUUUIDs requires unique canonical full physical GPU UUIDs: %q", id)
+		}
+		seen[id] = true
+	}
+	if config.Flags.MigStrategy == nil || *config.Flags.MigStrategy != spec.MigStrategyNone {
+		return fmt.Errorf("allowedGPUUUIDs requires migStrategy none")
+	}
+	if len(config.Sharing.TimeSlicing.Resources) != 0 || config.Sharing.MPS != nil {
+		return fmt.Errorf("allowedGPUUUIDs forbids replication and MPS configuration")
+	}
+	if config.Flags.DeviceDiscoveryStrategy == nil || (*config.Flags.DeviceDiscoveryStrategy != "auto" && *config.Flags.DeviceDiscoveryStrategy != "nvml") || infolib.ResolvePlatform() != info.PlatformNVML {
+		return fmt.Errorf("allowedGPUUUIDs requires native NVML discovery")
+	}
+	return nil
+}
