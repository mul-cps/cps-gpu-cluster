+package main
+
+import (
+	spec "github.com/NVIDIA/k8s-device-plugin/api/config/v1"
+	"github.com/stretchr/testify/require"
+	"os"
+	"path/filepath"
+	"sigs.k8s.io/yaml"
+	"testing"
+)
+
+func TestAllowedGPUUUIDsConfigManagerPreservesSelection(t *testing.T) {
+	for _, selection := range []string{"[]", "[GPU-16128952-b438-556a-00bb-93039ee24e56]"} {
+		dir := t.TempDir()
+		input := []byte("version: v1\nflags:\n  plugin:\n    allowedGPUUUIDs: " + selection + "\n")
+		require.NoError(t, os.WriteFile(filepath.Join(dir, "qualified"), input, 0600))
+		destination := filepath.Join(dir, "active")
+		changed, err := updateSymlink("qualified", &Flags{ConfigFileSrcdir: dir, ConfigFileDst: destination})
+		require.NoError(t, err)
+		require.True(t, changed)
+		data, err := os.ReadFile(destination)
+		require.NoError(t, err)
+		require.Equal(t, input, data)
+		var parsed spec.Config
+		require.NoError(t, yaml.Unmarshal(data, &parsed))
+		require.NotNil(t, parsed.Flags.Plugin.AllowedGPUUUIDs)
+		if selection == "[]" {
+			require.Empty(t, *parsed.Flags.Plugin.AllowedGPUUUIDs)
+		} else {
+			require.Equal(t, []string{"GPU-16128952-b438-556a-00bb-93039ee24e56"}, *parsed.Flags.Plugin.AllowedGPUUUIDs)
+		}
+		flags, err := yaml.Marshal(parsed.Flags)
+		require.NoError(t, err)
+		require.Contains(t, string(flags), "allowedGPUUUIDs:")
+	}
+}
