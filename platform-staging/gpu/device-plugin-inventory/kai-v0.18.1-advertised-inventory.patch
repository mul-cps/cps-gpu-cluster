diff --git a/pkg/scheduler/api/node_info/node_info.go b/pkg/scheduler/api/node_info/node_info.go
index 8fad1ab..808c937 100644
--- a/pkg/scheduler/api/node_info/node_info.go
+++ b/pkg/scheduler/api/node_info/node_info.go
@@ -680,6 +680,10 @@ func (ni *NodeInfo) GetNumberOfGPUsInNode() int64 {
 		})
 		return int64(ni.AllocatableVector.Get(resource_info.GPUIndex))
 	}
+	// Plain device-plugin inventory can be narrower than GFD; MIG and DRA retain their existing accounting.
+	if advertised, found := ni.Node.Status.Allocatable[resource_info.GPUResourceName]; found && !ni.HasDRAGPUs && !ni.IsMIGEnabled() {
+		return min(int64(numberOfGPUs), advertised.Value())
+	}
 	return int64(numberOfGPUs)
 }
 
