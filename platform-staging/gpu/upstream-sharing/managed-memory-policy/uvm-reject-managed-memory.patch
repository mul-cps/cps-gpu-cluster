--- a/usr/src/nvidia-620.70.06/nvidia-uvm/uvm_va_range.c
+++ b/usr/src/nvidia-620.70.06/nvidia-uvm/uvm_va_range.c
@@ -47,6 +47,12 @@
 #include <linux/dma-resv.h>
 #endif
 
+// Explicit opt-in for shared GPU nodes that cannot isolate managed residency.
+static bool uvm_reject_managed_memory = false;
+module_param(uvm_reject_managed_memory, bool, 0444);
+MODULE_PARM_DESC(uvm_reject_managed_memory,
+                 "Reject new managed VA ranges; semaphore and device P2P mappings remain supported.");
+
 static struct kmem_cache *g_uvm_va_range_managed_cache __read_mostly;
 static struct kmem_cache *g_uvm_va_range_external_cache __read_mostly;
 #if UVM_PROVIDES_DMA_BUF_IMPORTER()
@@ -258,6 +264,12 @@
     status = uvm_range_tree_add(&va_space->va_range_tree, &managed_range->va_range.node);
     if (status != NV_OK)
         goto error;
+
+    // Preserve collision status: mmap uses it to map semaphore and P2P ranges.
+    if (uvm_reject_managed_memory) {
+        status = NV_ERR_NOT_SUPPORTED;
+        goto error;
+    }
 
     if (out_managed_range)
         *out_managed_range = managed_range;
