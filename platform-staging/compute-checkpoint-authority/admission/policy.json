{
  "apiVersion": "admissionregistration.k8s.io/v1",
  "kind": "ValidatingAdmissionPolicy",
  "metadata": {
    "name": "cps-retired-compute-state-write-fence"
  },
  "spec": {
    "failurePolicy": "Fail",
    "matchConstraints": {
      "matchPolicy": "Exact",
      "resourceRules": [
        {
          "apiGroups": [
            ""
          ],
          "apiVersions": [
            "v1"
          ],
          "operations": [
            "CREATE"
          ],
          "resources": [
            "pods"
          ],
          "scope": "Namespaced"
        }
      ],
      "namespaceSelector": {},
      "objectSelector": {}
    },
    "matchConditions": [
      {
        "name": "exact-namespace",
        "expression": "request.namespace == 'cps-compute'"
      }
    ],
    "validations": [
      {
        "expression": "!has(object.spec.volumes) || object.spec.volumes.all(v, !has(v.persistentVolumeClaim) || v.persistentVolumeClaim.claimName != 'compute-state' || (has(v.persistentVolumeClaim.readOnly) && v.persistentVolumeClaim.readOnly == true))",
        "message": "compute-state is retired for new writable Pod mounts; use the current operator delivery claim or an explicit read-only audit mount.",
        "reason": "Forbidden"
      }
    ]
  }
}
