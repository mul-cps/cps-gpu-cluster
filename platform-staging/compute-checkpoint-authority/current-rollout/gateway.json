            "command": [
              "python",
              "-c",
              "from pathlib import Path; import os,stat; os.umask(0o077); p=Path('/kai-private/config'); p.mkdir(mode=0o700,exist_ok=True); directory=os.open(p,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW); assert os.fstat(directory).st_uid==os.geteuid(), 'Private config owner differs'; os.fchmod(directory,0o700); exec(\"for n in ('coordinator.json','policy.json','deployment.json'):\\n fd=os.open(n,os.O_WRONLY|os.O_CREAT|os.O_NOFOLLOW,0o600,dir_fd=directory)\\n s=os.fstat(fd)\\n assert stat.S_ISREG(s.st_mode) and s.st_uid==os.geteuid() and s.st_nlink==1 and stat.S_IMODE(s.st_mode)==0o600\\n os.ftruncate(fd,0)\\n stream=os.fdopen(fd,'wb'); stream.write(Path('/kai-seed').joinpath(n).read_bytes()); stream.flush(); os.fsync(stream.fileno()); stream.close()\"); os.close(directory); state=Path('/data/native-kai-runtime-private'); state.mkdir(mode=0o700,exist_ok=True); fd=os.open(state,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW); assert os.fstat(fd).st_uid==os.geteuid(), 'Private state owner differs'; os.fchmod(fd,0o700); exec(\"import fcntl\\nchildren=[]\\ntry:\\n names=('writer.lock','custody.sqlite','custody.sqlite-journal','custody.sqlite-wal','custody.sqlite-shm')\\n present=[]\\n for name in names:\\n  try: os.stat(name,dir_fd=fd,follow_symlinks=False)\\n  except FileNotFoundError: continue\\n  present.append(name)\\n assert not present or 'writer.lock' in present, 'Existing custody requires its original writer lock'\\n for name in present:\\n  child=os.open(name,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK,dir_fd=fd)\\n  children.append(child)\\n  info=os.fstat(child)\\n  assert stat.S_ISREG(info.st_mode) and info.st_uid==os.geteuid() and info.st_nlink==1, 'Owned single-link private state inode required'\\n  assert stat.S_IMODE(info.st_mode) in (0o600,0o660), 'Unexpected private state permissions'\\n  if name=='writer.lock': fcntl.flock(child,fcntl.LOCK_EX|fcntl.LOCK_NB)\\n # Normalize only fixed owned inodes after every proof, under the old lock.\\n for child in children: os.fchmod(child,0o600)\\nfinally:\\n for child in reversed(children): os.close(child)\\n\"); os.close(fd)"
            ],
