+func TestNativeCustodyBoundRetryDoesNotClaimSuccessOrChangePodRV(t *testing.T) {
+	scheme := runtime.NewScheme()
+	if err := v1alpha2.AddToScheme(scheme); err != nil {
+		t.Fatal(err)
+	}
+	if err := v1.AddToScheme(scheme); err != nil {
+		t.Fatal(err)
+	}
+	pod := &v1.Pod{ObjectMeta: metav1.ObjectMeta{Name: "workspace", Namespace: "cps", UID: "11111111-2222-4333-8444-555555555555", ResourceVersion: "7", Annotations: map[string]string{binding.NativePendingAnnotation: binding.NativePendingProtocol}}, Spec: v1.PodSpec{NodeName: "k3s-wk-gpu2"}}
+	request := &v1alpha2.BindRequest{ObjectMeta: metav1.ObjectMeta{Name: "request", Namespace: "cps", UID: "11111111-2222-4333-8444-555555555556", ResourceVersion: "8", Generation: 2}, Spec: v1alpha2.BindRequestSpec{PodName: pod.Name, SelectedNode: pod.Spec.NodeName}, Status: v1alpha2.BindRequestStatus{Phase: v1alpha2.BindRequestPhasePending}}
+	kube := fake.NewClientBuilder().WithScheme(scheme).WithStatusSubresource(pod, request).WithObjects(pod, request).Build()
+	logger := record.NewFakeRecorder(2)
+	r := &BindRequestReconciler{Client: kube, eventRecorder: logger}
+	if _, err := r.Reconcile(context.Background(), ctrl.Request{NamespacedName: client.ObjectKeyFromObject(request)}); !errors.Is(err, binding.ErrNativeCustodyHeld) {
+		t.Fatalf("ambiguous bound retry claimed success: %v", err)
+	}
+	current := &v1.Pod{}
+	if err := kube.Get(context.Background(), client.ObjectKeyFromObject(pod), current); err != nil {
+		t.Fatal(err)
+	}
+	currentRequest := &v1alpha2.BindRequest{}
+	if err := kube.Get(context.Background(), client.ObjectKeyFromObject(request), currentRequest); err != nil {
+		t.Fatal(err)
+	}
+	if current.ResourceVersion != "7" || currentRequest.ResourceVersion != "8" || currentRequest.Status.Phase != v1alpha2.BindRequestPhasePending || len(logger.Events) != 0 {
+		t.Fatal("hold rewrote actual prepared generation/status")
