+func TestNativeCustodyDoesNotRewritePreparedBindRequestGeneration(t *testing.T) {
+	scheme := runtime.NewScheme()
+	if err := v1alpha2.AddToScheme(scheme); err != nil {
+		t.Fatal(err)
+	}
+	request := &v1alpha2.BindRequest{ObjectMeta: metav1.ObjectMeta{Name: "request", Namespace: "cps", UID: "11111111-2222-4333-8444-555555555555", ResourceVersion: "8", Generation: 2}, Status: v1alpha2.BindRequestStatus{Phase: v1alpha2.BindRequestPhasePending}}
+	kube := fake.NewClientBuilder().WithScheme(scheme).WithStatusSubresource(request).WithObjects(request).Build()
+	r := &BindRequestReconciler{Client: kube}
+	if _, err := r.UpdateStatus(context.Background(), request, ctrl.Result{}, binding.ErrNativeCustodyHeld); !errors.Is(err, binding.ErrNativeCustodyHeld) {
+		t.Fatal(err)
+	}
+	current := &v1alpha2.BindRequest{}
+	if err := kube.Get(context.Background(), client.ObjectKeyFromObject(request), current); err != nil {
+		t.Fatal(err)
+	}
+	if current.ResourceVersion != "8" || current.Generation != 2 || current.Status.Phase != v1alpha2.BindRequestPhasePending {
+		t.Fatalf("hold changed prepared generation %+v", current)
+	}
+}
