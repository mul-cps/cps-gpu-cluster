+
+func TestNativeHTTPDisabledDoesNotReadCredentials(t *testing.T) {
+	bridge, err := NewNativeHTTP(NativeHTTPConfig{Enabled: false, URL: "invalid", TokenFile: "/not-read", CAFile: "/not-read"})
+	if err != nil || bridge != nil {
+		t.Fatalf("disabled bridge activated: %v", err)
+	}
+}
+
+func nativeTransportFixture(t *testing.T, handler http.HandlerFunc) (*NativeHTTP, string) {
+	t.Helper()
+	server := httptest.NewTLSServer(handler)
+	t.Cleanup(server.Close)
+	directory := t.TempDir()
+	token := filepath.Join(directory, "projected-token")
+	ca := filepath.Join(directory, "ca.crt")
+	if err := os.WriteFile(token, []byte("unit.header.signature"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(ca, pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: server.Certificate().Raw}), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	bridge, err := NewNativeHTTP(NativeHTTPConfig{Enabled: true, URL: server.URL, AuthorityNamespace: "authority", TokenFile: token, CAFile: ca})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return bridge, token
+}
+
+func TestNativeHTTPClosedWireFlowAndTokenRotation(t *testing.T) {
+	pod, node, br := nativeTestInputs()
+	pod.Annotations["received-resource-type"] = "Fraction"
+	ack := nativeTestACK(pod)
+	operations := []string{}
+	bridge, token := nativeTransportFixture(t, func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != "POST" || !strings.HasPrefix(r.URL.Path, "/api/native-kai/v1/") {
+			t.Errorf("unexpected route %s %s", r.Method, r.URL.Path)
+		}
+		var body map[string]interface{}
+		if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+			t.Error(err)
+		}
+		op := strings.TrimPrefix(r.URL.Path, "/api/native-kai/v1/")
+		operations = append(operations, op)
+		if body["protocol"] != "cps-native-kai-terminal/v1" || body["operation"] != op || body["request_id"] == "" {
+			t.Error("closed envelope missing identity")
+		}
+		expectedToken := "unit.header.signature"
+		if len(operations) > 1 {
+			expectedToken = "rotated.header.signature"
+		}
+		if r.Header.Get("Authorization") != "Bearer "+expectedToken {
+			t.Error("projected token not freshly loaded")
+		}
+		response := map[string]interface{}{"protocol": body["protocol"], "operation": op, "request_id": body["request_id"]}
+		if op == "prepare" {
+			response["fence_id"] = "aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee"
+			response["ack"] = ack
+		}
+		w.Header().Set("Content-Type", "application/json")
+		json.NewEncoder(w).Encode(response)
+	})
+	snapshot := NativeTerminalSnapshot{Pod: pod, Node: node, BindRequest: br, BindingState: nativeTestState()}
+	fence, err := bridge.Prepare(context.Background(), snapshot)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(token, []byte("rotated.header.signature"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := fence.ValidateCurrent(context.Background(), snapshot, ack); err != nil {
+		t.Fatal(err)
+	}
+	fence.Close()
+	if len(operations) != 3 || operations[0] != "prepare" || operations[1] != "current" || operations[2] != "close" {
+		t.Fatalf("wrong operations %v", operations)
+	}
+}
+
+func TestNativeHTTPRejectsRedirectAndMalformedClosedResponses(t *testing.T) {
+	for _, mode := range []string{"redirect", "wrong-id", "extra-field", "duplicate-field", "oversize"} {
+		t.Run(mode, func(t *testing.T) {
+			calls := 0
+			bridge, _ := nativeTransportFixture(t, func(w http.ResponseWriter, r *http.Request) {
+				calls++
+				var body map[string]interface{}
+				json.NewDecoder(r.Body).Decode(&body)
+				if mode == "redirect" {
+					http.Redirect(w, r, "https://foreign.example.invalid/token-target", http.StatusTemporaryRedirect)
+					return
+				}
+				response := map[string]interface{}{"protocol": body["protocol"], "operation": body["operation"], "request_id": body["request_id"]}
+				if mode == "wrong-id" {
+					response["request_id"] = "foreign"
+				}
+				if mode == "extra-field" {
+					response["grant"] = true
+				}
+				w.Header().Set("Content-Type", "application/json")
+				if mode == "duplicate-field" {
+					w.Write([]byte(`{"protocol":"cps-native-kai-terminal/v1","protocol":"other","operation":"hold","request_id":"unused"}`))
+					return
+				}
+				if mode == "oversize" {
+					w.Write([]byte(strings.Repeat("x", 1024*1024+1)))
+					return
+				}
+				json.NewEncoder(w).Encode(response)
+			})
+			if err := bridge.Hold(context.Background(), "11111111-2222-4333-8444-555555555555", nil); err == nil {
+				t.Fatal("malformed/redirected response accepted")
+			}
+			if calls != 1 {
+				t.Fatalf("unexpected automatic retry/redirect %d", calls)
+			}
+		})
+	}
+}
+
+func TestNativeHTTPRejectsForeignOrInsecureConfiguration(t *testing.T) {
+	for _, url := range []string{"http://coordinator.invalid", "https://user:secret@coordinator.invalid", "https://coordinator.invalid/api", "https://coordinator.invalid?other=1", "https://coordinator.invalid#fragment"} {
+		if _, err := NewNativeHTTP(NativeHTTPConfig{Enabled: true, URL: url, AuthorityNamespace: "authority", TokenFile: "/not-read", CAFile: "/not-read"}); err == nil {
+			t.Fatal("unsafe coordinator configuration accepted")
+		}
+	}
+}
+
+func TestNativeHTTPAllWireMethodsAndTypedReservationDecision(t *testing.T) {
+	pod, node, br := nativeTestInputs()
+	ack := nativeTestACK(pod)
+	calls := []string{}
+	bridge, _ := nativeTransportFixture(t, func(w http.ResponseWriter, r *http.Request) {
+		var body map[string]interface{}
+		if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+			t.Error(err)
+		}
+		op := strings.TrimPrefix(r.URL.Path, "/api/native-kai/v1/")
+		calls = append(calls, op)
+		response := map[string]interface{}{"protocol": body["protocol"], "operation": body["operation"], "request_id": body["request_id"]}
+		if op == "prepare" {
+			response["fence_id"] = "aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee"
+			response["ack"] = ack
+		}
+		if op == "cleanup-maps" {
+			response["maps"] = []v1.ConfigMap{*ack}
+		}
+		if op == "reservation-delete" {
+			response["may_delete"] = false
+		}
+		if op == "binding" || op == "accepted" {
+			binding := body["binding"].(map[string]interface{})
+			if len(binding["metadata"].(map[string]interface{})) != 4 || len(binding["target"].(map[string]interface{})) != 3 {
+				t.Error("actual Binding wire expanded")
+			}
+		}
+		w.Header().Set("Content-Type", "application/json")
+		json.NewEncoder(w).Encode(response)
+	})
+	fence, err := bridge.Prepare(context.Background(), NativeTerminalSnapshot{Pod: pod, Node: node, BindRequest: br, BindingState: nativeTestState()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	binding := &unstructured.Unstructured{Object: map[string]interface{}{"apiVersion": "v1", "kind": "Binding", "metadata": map[string]interface{}{"namespace": pod.Namespace, "name": pod.Name, "uid": string(pod.UID), "resourceVersion": pod.ResourceVersion}, "target": map[string]interface{}{"kind": "Node", "name": node.Name, "uid": string(node.UID)}}}
+	if err = fence.ValidateBinding(context.Background(), binding); err != nil {
+		t.Fatal(err)
+	}
+	if err = fence.BindingAccepted(context.Background(), binding); err != nil {
+		t.Fatal(err)
+	}
+	if err = bridge.Hold(context.Background(), pod.UID, nil); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = bridge.CleanupMaps(context.Background(), pod.UID); err != nil {
+		t.Fatal(err)
+	}
+	if allowed, err := bridge.MayDeleteReservation(context.Background(), pod); err != nil || allowed {
+		t.Fatal("typed false custody decision not retained")
+	}
+	fence.Close()
+	fence.Close()
+	if !reflect.DeepEqual(calls, []string{"prepare", "binding", "accepted", "hold", "cleanup-maps", "reservation-delete", "close"}) {
+		t.Fatalf("wire methods differ %v", calls)
+	}
+}
+
+func TestNativeHTTPOpaqueUserTokenNeverReachesCoordinator(t *testing.T) {
+	calls := 0
+	bridge, token := nativeTransportFixture(t, func(w http.ResponseWriter, r *http.Request) { calls++; t.Error("unsigned user token sent") })
+	if err := os.WriteFile(token, []byte("opaque-human-api-token"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := bridge.Hold(context.Background(), "11111111-2222-4333-8444-555555555555", nil); err == nil || calls != 0 {
+		t.Fatal("unsigned token crossed internal transport")
+	}
+}
