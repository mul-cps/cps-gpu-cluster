+func TestNativeCustodyOuterBoundaryPreservesPendingAndOrdinaryErrors(t *testing.T) {
+	for _, mode := range []string{"joined-custody", "ordinary-error", "snapshot-refresh"} {
+		held := mode != "ordinary-error"
+		t.Run(mode, func(t *testing.T) {
+			scheme := runtime.NewScheme()
+			_ = v1.AddToScheme(scheme)
+			_ = v1alpha2.AddToScheme(scheme)
+			node := &v1.Node{ObjectMeta: metav1.ObjectMeta{Name: "k3s-wk-gpu2"}}
+			pod := &v1.Pod{ObjectMeta: metav1.ObjectMeta{Name: "workspace", Namespace: "cps", UID: "11111111-2222-4333-8444-555555555555", ResourceVersion: "7", Annotations: map[string]string{binding.NativePendingAnnotation: binding.NativePendingProtocol}}}
+			limit := int32(3)
+			request := &v1alpha2.BindRequest{ObjectMeta: metav1.ObjectMeta{Name: "request", Namespace: "cps", UID: "11111111-2222-4333-8444-555555555556", ResourceVersion: "8", Generation: 2}, Spec: v1alpha2.BindRequestSpec{PodName: pod.Name, SelectedNode: node.Name, BackoffLimit: &limit}, Status: v1alpha2.BindRequestStatus{Phase: v1alpha2.BindRequestPhasePending}}
+			kube := fake.NewClientBuilder().WithScheme(scheme).WithStatusSubresource(pod, request).WithObjects(pod, request, node).Build()
+			logger := record.NewFakeRecorder(2)
+			mock := mock_binder.NewMockInterface(gomock.NewController(t))
+			cause := errors.New("bounded test failure")
+			failure := cause
+			if held {
+				failure = errors.Join(binding.ErrNativeCustodyHeld, cause)
+				if mode == "snapshot-refresh" {
+					failure = errors.Join(failure, binding.ErrNativePrepareSnapshotRefresh)
+				}
+			}
+			mock.EXPECT().Bind(gomock.Any(), gomock.Any(), gomock.Any(), gomock.Any()).Return(failure)
+			if !held {
+				mock.EXPECT().Rollback(gomock.Any(), gomock.Any(), gomock.Any(), gomock.Any()).Return(nil)
+			}
+			r := &BindRequestReconciler{Client: kube, eventRecorder: logger, binder: mock}
+			result, err := r.Reconcile(context.Background(), ctrl.Request{NamespacedName: client.ObjectKeyFromObject(request)})
+			currentPod := &v1.Pod{}
+			_ = kube.Get(context.Background(), client.ObjectKeyFromObject(pod), currentPod)
+			currentRequest := &v1alpha2.BindRequest{}
+			_ = kube.Get(context.Background(), client.ObjectKeyFromObject(request), currentRequest)
+			if held {
+				if err != nil || result.RequeueAfter != time.Second || currentPod.ResourceVersion != "7" || len(currentPod.Status.Conditions) != 0 || currentRequest.ResourceVersion != "8" || currentRequest.Generation != 2 || currentRequest.Status.Phase != v1alpha2.BindRequestPhasePending || currentRequest.Status.FailedAttempts != 0 || len(logger.Events) != 0 {
+					t.Fatalf("custody was reported as error/success or mutated pending objects: %+v %v %+v %+v", result, err, currentPod.Status, currentRequest.Status)
+				}
+			} else if !errors.Is(err, cause) || result.RequeueAfter != time.Second || currentRequest.Status.Phase != v1alpha2.BindRequestPhaseFailed || currentRequest.Status.FailedAttempts != 1 {
+				t.Fatalf("ordinary error/backoff swallowed: %+v %v %+v", result, err, currentRequest.Status)
+			}
+		})
+	}
+}
