+// Real Reconcile must report a fixed diagnostic code without logging nested
+// error text, while retaining its existing one-second Pending custody retry.
+func TestNativeCustodyRetryLogsSanitizedReason(t *testing.T) {
+	for _, tc := range []struct{ name, message, reason string }{
+		{"snapshot", "current BindRequest generation differs", "bind-request-current"},
+		{"transport", "coordinator prepare transport failed", "prepare-transport"},
+		{"nested-secret", "Authorization: Bearer PRIVATE_TOKEN /private/credential", "unclassified"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			scheme := runtime.NewScheme()
+			_ = v1.AddToScheme(scheme)
+			_ = v1alpha2.AddToScheme(scheme)
+			node := &v1.Node{ObjectMeta: metav1.ObjectMeta{Name: "k3s-wk-gpu2"}}
+			pod := &v1.Pod{ObjectMeta: metav1.ObjectMeta{Name: "workspace", Namespace: "cps", UID: "11111111-2222-4333-8444-555555555555", ResourceVersion: "7", Annotations: map[string]string{binding.NativePendingAnnotation: binding.NativePendingProtocol}}}
+			request := &v1alpha2.BindRequest{ObjectMeta: metav1.ObjectMeta{Name: "request", Namespace: "cps", UID: "11111111-2222-4333-8444-555555555556", ResourceVersion: "8", Generation: 2}, Spec: v1alpha2.BindRequestSpec{PodName: pod.Name, SelectedNode: node.Name}, Status: v1alpha2.BindRequestStatus{Phase: v1alpha2.BindRequestPhasePending}}
+			kube := fake.NewClientBuilder().WithScheme(scheme).WithStatusSubresource(pod, request).WithObjects(pod, request, node).Build()
+			mock := mock_binder.NewMockInterface(gomock.NewController(t))
+			cause := fmt.Errorf("PRIVATE_TOKEN wrapper: %w", errors.Join(errors.New(tc.message), errors.New("secret=PRIVATE_TOKEN")))
+			mock.EXPECT().Bind(gomock.Any(), gomock.Any(), gomock.Any(), gomock.Any()).Return(errors.Join(binding.ErrNativeCustodyHeld, cause))
+			var output strings.Builder
+			ctx := log.IntoContext(context.Background(), funcr.New(func(_, args string) { output.WriteString(args) }, funcr.Options{}))
+			r := &BindRequestReconciler{Client: kube, eventRecorder: record.NewFakeRecorder(2), binder: mock}
+			result, err := r.Reconcile(ctx, ctrl.Request{NamespacedName: client.ObjectKeyFromObject(request)})
+			current := &v1alpha2.BindRequest{}
+			_ = kube.Get(ctx, client.ObjectKeyFromObject(request), current)
+			if err != nil || result.RequeueAfter != time.Second || current.ResourceVersion != "8" || current.Generation != 2 || current.Status.Phase != v1alpha2.BindRequestPhasePending {
+				t.Fatalf("retry changed: %+v %v %+v", result, err, current)
+			}
+			got := output.String()
+			if !strings.Contains(got, "Native allocation custody held; retrying") || !strings.Contains(got, tc.reason) {
+				t.Fatalf("missing sanitized held reason %q in %s", tc.reason, got)
+			}
+			for _, secret := range []string{"PRIVATE_TOKEN", "Authorization", "/private/credential", "secret="} {
+				if strings.Contains(got, secret) {
+					t.Fatalf("nested private error leaked: %s", got)
+				}
+			}
+		})
+	}
+}
