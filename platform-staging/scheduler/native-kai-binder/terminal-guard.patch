diff --git a/pkg/binder/binding/native_terminal.go b/pkg/binder/binding/native_terminal.go
new file mode 100644
index 0000000..3dc39f6
--- /dev/null
+++ b/pkg/binder/binding/native_terminal.go
@@ -0,0 +1,267 @@
+// SPDX-License-Identifier: Apache-2.0
+
+package binding
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"reflect"
+	"time"
+
+	v1 "k8s.io/api/core/v1"
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/apis/meta/v1/unstructured"
+	"k8s.io/apimachinery/pkg/types"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+
+	"github.com/kai-scheduler/KAI-scheduler/pkg/apis/scheduling/v1alpha2"
+	"github.com/kai-scheduler/KAI-scheduler/pkg/binder/plugins/state"
+)
+
+const NativePendingAnnotation = "cps.compute/native-pending"
+const NativePendingProtocol = "kai-v0.18.1-gpu2-cm/v1"
+const nativeApprovedNode = "k3s-wk-gpu2"
+const nativeApprovedNodeUID = "3336cdd5-d245-436e-b57c-2f66c6dcaa41"
+const nativeApprovedGPU = "GPU-16128952-b438-556a-00bb-93039ee24e56"
+
+// This signals durable custody, not successful Binding or cleanup. Controller
+// retries must not run the upstream unconditional rollback or change the ACK's
+// BindRequest generation by writing Failed status.
+var ErrNativeCustodyHeld = errors.New("native allocation custody held; reconciliation required")
+
+// NativeTerminalSnapshot contains actual upstream types, never a new wire ACK
+// schema. The coordinator must perform the full strict SDK comparisons, central
+// authorization and capacity accounting, freeze maps, publish/read back v1
+// enrollment and ACK, and retain its writer fence through Binding.
+type NativeTerminalSnapshot struct {
+	Pod          *v1.Pod
+	Node         *v1.Node
+	BindRequest  *v1alpha2.BindRequest
+	BindingState *state.BindingState
+}
+
+type NativeAllocationFence interface {
+	ACK() *v1.ConfigMap
+	ValidateCurrent(context.Context, NativeTerminalSnapshot, *v1.ConfigMap) error
+	ValidateBinding(context.Context, *unstructured.Unstructured) error
+	BindingAccepted(context.Context, *unstructured.Unstructured) error
+	Close()
+}
+
+// CleanupMaps may return exact actual immutable map snapshots only after the
+// coordinator independently proves old PodUID absence and native-zero cleanup.
+// It must retain capacity and reservation custody on any ambiguity. No transport
+// implementation or authentication is supplied by this staging patch.
+type NativeTerminalCoordinator interface {
+	Prepare(context.Context, NativeTerminalSnapshot) (NativeAllocationFence, error)
+	Hold(context.Context, types.UID, error) error
+	CleanupMaps(context.Context, types.UID) ([]v1.ConfigMap, error)
+}
+
+// Configure only during startup. A nil/absent bridge remains fail closed for
+// every marked Pod; unmarked upstream behavior is unchanged. reader must be the
+// manager APIReader (the upstream client is cache backed).
+func (b *Binder) SetNativeTerminal(reader client.Reader, authorityNamespace string, coordinator NativeTerminalCoordinator) {
+	b.nativeReader, b.nativeAuthorityNamespace, b.nativeCoordinator = reader, authorityNamespace, coordinator
+}
+
+func nativeMarked(pod *v1.Pod) bool {
+	_, present := pod.Annotations[NativePendingAnnotation]
+	return present
+}
+
+func (b *Binder) nativeConfigured(pod *v1.Pod) error {
+	if pod.Annotations[NativePendingAnnotation] != NativePendingProtocol || b.nativeReader == nil || b.nativeCoordinator == nil || b.nativeAuthorityNamespace == "" {
+		return ErrNativeCustodyHeld
+	}
+	guarded, ok := b.resourceReservationService.(interface{ NativeCustodyEnabled() bool })
+	if !ok || !guarded.NativeCustodyEnabled() {
+		return fmt.Errorf("reservation custody guard is not configured: %w", ErrNativeCustodyHeld)
+	}
+	return nil
+}
+
+func (b *Binder) nativeSnapshot(ctx context.Context, pod *v1.Pod, node *v1.Node, br *v1alpha2.BindRequest, bindingState *state.BindingState) (NativeTerminalSnapshot, error) {
+	currentPod, currentNode, currentBR := &v1.Pod{}, &v1.Node{}, &v1alpha2.BindRequest{}
+	for _, object := range []client.Object{currentPod, currentNode, currentBR} {
+		var key client.ObjectKey
+		switch object.(type) {
+		case *v1.Pod:
+			key = client.ObjectKeyFromObject(pod)
+		case *v1.Node:
+			key = client.ObjectKeyFromObject(node)
+		default:
+			key = client.ObjectKeyFromObject(br)
+		}
+		if err := b.nativeReader.Get(ctx, key, object); err != nil {
+			return NativeTerminalSnapshot{}, err
+		}
+	}
+	if currentPod.UID != pod.UID || currentPod.UID == "" || currentPod.ResourceVersion == "" || currentPod.DeletionTimestamp != nil || currentPod.Spec.NodeName != "" || !reflect.DeepEqual(currentPod.Spec, pod.Spec) || currentPod.Annotations[NativePendingAnnotation] != NativePendingProtocol {
+		return NativeTerminalSnapshot{}, fmt.Errorf("current Pod UID/spec/lifecycle differs")
+	}
+	if currentNode.Name != nativeApprovedNode || string(currentNode.UID) != nativeApprovedNodeUID || currentNode.UID != node.UID || currentNode.DeletionTimestamp != nil || currentNode.ResourceVersion == "" {
+		return NativeTerminalSnapshot{}, fmt.Errorf("current selected Node identity differs")
+	}
+	if currentBR.UID != br.UID || currentBR.ResourceVersion != br.ResourceVersion || currentBR.Generation != br.Generation || currentBR.DeletionTimestamp != nil || !reflect.DeepEqual(currentBR.Spec, br.Spec) {
+		return NativeTerminalSnapshot{}, fmt.Errorf("current BindRequest generation differs")
+	}
+	for key, value := range bindingState.BindingPodAnnotations {
+		if currentPod.Annotations[key] != value {
+			return NativeTerminalSnapshot{}, fmt.Errorf("final binding annotation is not persisted")
+		}
+	}
+	copyState := &state.BindingState{BindingPodAnnotations: map[string]string{}, ReservedGPUIds: append([]string(nil), bindingState.ReservedGPUIds...)}
+	for key, value := range bindingState.BindingPodAnnotations {
+		copyState.BindingPodAnnotations[key] = value
+	}
+	return NativeTerminalSnapshot{currentPod, currentNode, currentBR, copyState}, nil
+}
+
+func (b *Binder) nativeHold(pod *v1.Pod, cause error) error {
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	if b.nativeCoordinator != nil {
+		cause = errors.Join(cause, b.nativeCoordinator.Hold(ctx, pod.UID, cause))
+	}
+	return errors.Join(ErrNativeCustodyHeld, cause)
+}
+
+func (b *Binder) bindNativeTerminal(ctx context.Context, pod *v1.Pod, node *v1.Node, br *v1alpha2.BindRequest, bindingState *state.BindingState) (err error) {
+	failureHandled := false
+	defer func() {
+		if err != nil && !failureHandled {
+			err = b.nativeHold(pod, err)
+		}
+	}()
+	if err = b.nativeConfigured(pod); err != nil {
+		return err
+	}
+	if len(bindingState.ReservedGPUIds) != 1 || bindingState.ReservedGPUIds[0] != nativeApprovedGPU {
+		return fmt.Errorf("exact approved physical GPU UUID required")
+	}
+	snapshot, err := b.nativeSnapshot(ctx, pod, node, br, bindingState)
+	if err != nil {
+		return err
+	}
+	fence, err := b.nativeCoordinator.Prepare(ctx, snapshot)
+	if fence != nil {
+		defer func() {
+			if err != nil {
+				err = b.nativeHold(pod, err)
+			}
+			failureHandled = true
+			fence.Close()
+		}()
+	}
+	if err != nil {
+		return err
+	}
+	if fence == nil {
+		return fmt.Errorf("terminal coordinator did not retain a fence")
+	}
+	expectedACK := fence.ACK()
+	if expectedACK == nil || expectedACK.Name != "cps-pending-allocation-"+string(pod.UID) || expectedACK.Namespace != b.nativeAuthorityNamespace || expectedACK.UID == "" || expectedACK.ResourceVersion == "" {
+		return fmt.Errorf("actual immutable ACK reference required")
+	}
+	currentACK := &v1.ConfigMap{}
+	if err = b.nativeReader.Get(ctx, client.ObjectKeyFromObject(expectedACK), currentACK); err != nil {
+		return err
+	}
+	if currentACK.UID != expectedACK.UID || currentACK.ResourceVersion != expectedACK.ResourceVersion || currentACK.Immutable == nil || !*currentACK.Immutable || currentACK.DeletionTimestamp != nil || len(currentACK.OwnerReferences) != 0 || len(currentACK.BinaryData) != 0 || len(currentACK.Data) != 1 || currentACK.Data["allocation.json"] == "" {
+		return fmt.Errorf("immutable ACK identity/data shape changed")
+	}
+	snapshot, err = b.nativeSnapshot(ctx, pod, node, br, bindingState)
+	if err != nil {
+		return err
+	}
+	// The bridge re-reads registry/maps/enrollment/epoch/central authority under
+	// the retained fence and uses validate_current_pending_allocation and the
+	// full immutable ACK validator. Selected-field comparisons are insufficient.
+	if err = fence.ValidateCurrent(ctx, snapshot, currentACK.DeepCopy()); err != nil {
+		return err
+	}
+	if err = ctx.Err(); err != nil {
+		return err
+	}
+	// Preserve the SDK's exact closed wire object. Typed ObjectMeta serialization
+	// can add creationTimestamp:null, which is outside that reviewed contract.
+	binding := &unstructured.Unstructured{Object: map[string]interface{}{
+		"apiVersion": "v1", "kind": "Binding",
+		"metadata": map[string]interface{}{"namespace": pod.Namespace, "name": pod.Name, "uid": string(pod.UID), "resourceVersion": snapshot.Pod.ResourceVersion},
+		"target":   map[string]interface{}{"kind": "Node", "name": node.Name, "uid": string(node.UID)},
+	}}
+	if err = fence.ValidateBinding(ctx, binding.DeepCopy()); err != nil {
+		return err
+	}
+	if err = ctx.Err(); err != nil {
+		return err
+	}
+	if err = b.kubeClient.SubResource("binding").Create(ctx, snapshot.Pod, binding); err != nil {
+		return err
+	}
+	// An ambiguous Bound publication still holds custody; never rollback maps
+	// after a lost/successful Binding response. Strict future-B/native cap checks
+	// belong to the existing post-Bind node path, not this pre-Bind ACK.
+	if err = fence.BindingAccepted(ctx, binding.DeepCopy()); err != nil {
+		return err
+	}
+	return nil
+}
+
+// Cancel only the exact current PodUID/RV. Even a successful DELETE response
+// retains maps/reservations until a later absence and native-zero proof.
+func (b *Binder) cancelNative(ctx context.Context, pod *v1.Pod, br *v1alpha2.BindRequest) error {
+	if err := b.nativeConfigured(pod); err != nil {
+		return err
+	}
+	cleanupCtx, cancel := context.WithTimeout(context.WithoutCancel(ctx), 5*time.Second)
+	defer cancel()
+	current := &v1.Pod{}
+	err := b.nativeReader.Get(cleanupCtx, client.ObjectKeyFromObject(pod), current)
+	if err == nil && current.UID == pod.UID {
+		if holdErr := b.nativeCoordinator.Hold(cleanupCtx, pod.UID, ErrNativeCustodyHeld); holdErr != nil {
+			return errors.Join(ErrNativeCustodyHeld, holdErr)
+		}
+		uid, rv := current.UID, current.ResourceVersion
+		err = b.kubeClient.Delete(cleanupCtx, current, &client.DeleteOptions{Preconditions: &metav1.Preconditions{UID: &uid, ResourceVersion: &rv}})
+		return errors.Join(ErrNativeCustodyHeld, err)
+	}
+	if err != nil && !apierrors.IsNotFound(err) {
+		return b.nativeHold(pod, err)
+	}
+	// A replacement UID proves only the old Pod is absent; it is never deleted,
+	// patched or used as the old Pod's native-zero evidence.
+	maps, err := b.nativeCoordinator.CleanupMaps(cleanupCtx, pod.UID)
+	if err != nil {
+		return b.nativeHold(pod, err)
+	}
+	prefix := pod.Annotations["runai/shared-gpu-configmap"]
+	if prefix == "" || len(maps) != 2 {
+		return b.nativeHold(pod, fmt.Errorf("exact two compiled native maps required for cleanup"))
+	}
+	expectedNames := map[string]bool{prefix + "-0": true, prefix + "-0-evar": true}
+	for _, expected := range maps {
+		if !expectedNames[expected.Name] || expected.Namespace != pod.Namespace {
+			return b.nativeHold(pod, fmt.Errorf("foreign or duplicate native cleanup map"))
+		}
+		delete(expectedNames, expected.Name)
+		currentMap := &v1.ConfigMap{}
+		if err = b.nativeReader.Get(cleanupCtx, client.ObjectKeyFromObject(&expected), currentMap); apierrors.IsNotFound(err) {
+			continue
+		}
+		if err != nil {
+			return b.nativeHold(pod, err)
+		}
+		if expected.UID == "" || expected.ResourceVersion == "" || currentMap.UID != expected.UID || currentMap.ResourceVersion != expected.ResourceVersion || currentMap.Namespace != pod.Namespace || len(currentMap.OwnerReferences) != 1 || currentMap.OwnerReferences[0].UID != pod.UID || currentMap.OwnerReferences[0].Kind != "Pod" || currentMap.OwnerReferences[0].Name != pod.Name {
+			return b.nativeHold(pod, fmt.Errorf("cleanup map is replaced or not owned by exact old PodUID"))
+		}
+		uid, rv := currentMap.UID, currentMap.ResourceVersion
+		if err = b.kubeClient.Delete(cleanupCtx, currentMap, &client.DeleteOptions{Preconditions: &metav1.Preconditions{UID: &uid, ResourceVersion: &rv}}); err != nil {
+			return b.nativeHold(pod, err)
+		}
+	}
+	return b.resourceReservationService.SyncForNode(cleanupCtx, br.Spec.SelectedNode)
+}
