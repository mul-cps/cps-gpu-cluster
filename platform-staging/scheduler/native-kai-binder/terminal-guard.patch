+	ack := nativeTestACK(pod)
+	coord := &nativeTestCoordinator{ack: ack}
+	var actualBinding *v1.Binding
+	kube := nativeTestClient(t, pod, node, br, func(binding *v1.Binding) error {
+		coord.calls = append(coord.calls, "binding")
+		actualBinding = binding.DeepCopy()
+		return nil
+	}, ack)
+	coord.prepare = func(s NativeTerminalSnapshot) {
+		if s.Pod.Annotations["received-resource-type"] != "Fraction" {
+			t.Fatal("ACK prepared before final annotations persisted")
+		}
+		if s.Pod.ResourceVersion == "1" {
+			t.Fatal("ACK used original Pod RV before persisted patch")
+		}
+	}
+	coord.validate = func(s NativeTerminalSnapshot) error {
+		if s.Pod.ResourceVersion == "1" {
