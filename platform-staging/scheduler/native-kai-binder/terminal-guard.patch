+
+	v1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/apis/meta/v1/unstructured"
+	"k8s.io/apimachinery/pkg/runtime"
+	"k8s.io/apimachinery/pkg/types"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+	"sigs.k8s.io/controller-runtime/pkg/client/fake"
+	"sigs.k8s.io/controller-runtime/pkg/client/interceptor"
+
+	"github.com/kai-scheduler/KAI-scheduler/pkg/apis/scheduling/v1alpha2"
+	"github.com/kai-scheduler/KAI-scheduler/pkg/binder/plugins"
+	"github.com/kai-scheduler/KAI-scheduler/pkg/binder/plugins/state"
+)
+
+type nativeBindingSubClient struct {
+	client.SubResourceClient
+	bind func(*v1.Binding) error
+}
+
+func (c *nativeBindingSubClient) Create(ctx context.Context, obj client.Object, sub client.Object, opts ...client.SubResourceCreateOption) error {
+	if binding, ok := sub.(*v1.Binding); ok {
+		return c.bind(binding)
+	}
+	raw := sub.(*unstructured.Unstructured)
+	metadata := raw.Object["metadata"].(map[string]interface{})
+	if len(metadata) != 4 {
+		return errors.New("Binding wire metadata is not closed")
+	}
+	binding := &v1.Binding{}
+	if err := runtime.DefaultUnstructuredConverter.FromUnstructured(raw.Object, binding); err != nil {
+		return err
+	}
+	return c.bind(binding)
+}
+
+type nativeTestReservation struct{ removed int }
+
+func (*nativeTestReservation) NativeCustodyEnabled() bool { return true }
+
+func (*nativeTestReservation) Sync(context.Context) error                    { return nil }
+func (*nativeTestReservation) SyncForNode(context.Context, string) error     { return nil }
+func (*nativeTestReservation) SyncForGpuGroup(context.Context, string) error { return nil }
+func (*nativeTestReservation) ReserveGpuDevice(context.Context, *v1.Pod, string, v1alpha2.FractionalGpuGroup) (string, error) {
+	return "GPU-16128952-b438-556a-00bb-93039ee24e56", nil
+}
+func (r *nativeTestReservation) RemovePodGpuGroupsConnection(context.Context, *v1.Pod) error {
+	r.removed++
+	return nil
+}
+
+func nativeTestClient(t *testing.T, pod *v1.Pod, node *v1.Node, br *v1alpha2.BindRequest, bind func(*v1.Binding) error, objects ...client.Object) client.WithWatch {
+	t.Helper()
+	scheme := runtime.NewScheme()
+	if err := v1.AddToScheme(scheme); err != nil {
+		t.Fatal(err)
+	}
+	if err := v1alpha2.AddToScheme(scheme); err != nil {
+		t.Fatal(err)
+	}
+	objects = append(objects, pod, node, br)
+	return fake.NewClientBuilder().WithScheme(scheme).WithObjects(objects...).WithInterceptorFuncs(interceptor.Funcs{
+		SubResource: func(c client.WithWatch, sub string) client.SubResourceClient {
+			if sub != "binding" {
+				t.Fatalf("unexpected subresource %s", sub)
+			}
+			return &nativeBindingSubClient{bind: bind}
+		},
+	}).Build()
+}
+
+func nativeTestInputs() (*v1.Pod, *v1.Node, *v1alpha2.BindRequest) {
+	pod := &v1.Pod{ObjectMeta: metav1.ObjectMeta{Name: "notebook", Namespace: "cps", UID: "11111111-2222-4333-8444-555555555555", ResourceVersion: "1", Annotations: map[string]string{"cps.compute/native-pending": "kai-v0.18.1-gpu2-cm/v1", "runai/shared-gpu-configmap": "cps-native-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa-shared-gpu"}}, Spec: v1.PodSpec{Containers: []v1.Container{{Name: "notebook", Image: "fixed"}}}}
+	node := &v1.Node{ObjectMeta: metav1.ObjectMeta{Name: "k3s-wk-gpu2", UID: "3336cdd5-d245-436e-b57c-2f66c6dcaa41", ResourceVersion: "1"}}
+	br := &v1alpha2.BindRequest{ObjectMeta: metav1.ObjectMeta{Name: "request", Namespace: "cps", UID: "11111111-2222-4333-8444-555555555556", ResourceVersion: "1", Generation: 1}, Spec: v1alpha2.BindRequestSpec{PodName: pod.Name, SelectedNode: node.Name, ReceivedResourceType: "cpu"}}
+	return pod, node, br
+}
+
+// These fakes qualify ordering and API preconditions only. They are not an
+// authenticated coordinator, SDK authority validator or native cap receipt.
+type nativeTestCoordinator struct {
+	ack        *v1.ConfigMap
+	calls      []string
+	prepare    func(NativeTerminalSnapshot)
+	validate   func(NativeTerminalSnapshot) error
+	cleanupErr error
+	maps       []v1.ConfigMap
+}
+
+func (c *nativeTestCoordinator) Prepare(ctx context.Context, s NativeTerminalSnapshot) (NativeAllocationFence, error) {
+	c.calls = append(c.calls, "prepare")
+	if c.prepare != nil {
+		c.prepare(s)
+	}
+	return &nativeTestFence{c}, nil
+}
+func (c *nativeTestCoordinator) Hold(ctx context.Context, uid types.UID, err error) error {
+	if ctx.Err() != nil {
+		return errors.New("hold used a cancelled context")
+	}
+	c.calls = append(c.calls, "hold")
+	return nil
+}
+func (c *nativeTestCoordinator) CleanupMaps(ctx context.Context, uid types.UID) ([]v1.ConfigMap, error) {
+	c.calls = append(c.calls, "cleanup")
+	return c.maps, c.cleanupErr
+}
+
+type nativeTestFence struct{ c *nativeTestCoordinator }
+
+func (f *nativeTestFence) ACK() *v1.ConfigMap { return f.c.ack.DeepCopy() }
+func (f *nativeTestFence) ValidateCurrent(ctx context.Context, s NativeTerminalSnapshot, ack *v1.ConfigMap) error {
+	f.c.calls = append(f.c.calls, "validate")
+	if f.c.validate != nil {
+		return f.c.validate(s)
+	}
+	return nil
+}
+func (f *nativeTestFence) ValidateBinding(ctx context.Context, binding *unstructured.Unstructured) error {
+	f.c.calls = append(f.c.calls, "validate-binding")
+	return nil
+}
+func (f *nativeTestFence) BindingAccepted(ctx context.Context, binding *unstructured.Unstructured) error {
+	f.c.calls = append(f.c.calls, "bound")
+	return nil
+}
+func (f *nativeTestFence) Close() { f.c.calls = append(f.c.calls, "close") }
+func nativeTestACK(pod *v1.Pod) *v1.ConfigMap {
+	yes := true
+	return &v1.ConfigMap{ObjectMeta: metav1.ObjectMeta{Name: "cps-pending-allocation-" + string(pod.UID), Namespace: "authority", UID: "11111111-2222-4333-8444-555555555557", ResourceVersion: "9"}, Immutable: &yes, Data: map[string]string{"allocation.json": "{}"}}
+}
+func nativeTestState() *state.BindingState {
+	return &state.BindingState{BindingPodAnnotations: map[string]string{"received-resource-type": "Fraction"}, ReservedGPUIds: []string{nativeApprovedGPU}}
+}
+
+func TestNativeTerminalACKFollowsPersistedAnnotationsAndPrecedesBinding(t *testing.T) {
+	pod, node, br := nativeTestInputs()
+	br.Spec.ReceivedResourceType = "Fraction"
+	br.Spec.SelectedFractionalGpuGroups = []v1alpha2.FractionalGpuGroup{{ID: "group", ComputeSharingMode: v1alpha2.GPUComputeSharingModeTimeSlicing}}
+	ack := nativeTestACK(pod)
+	coord := &nativeTestCoordinator{ack: ack}
+	var actualBinding *v1.Binding
+	kube := nativeTestClient(t, pod, node, br, func(binding *v1.Binding) error {
+		coord.calls = append(coord.calls, "binding")
+		actualBinding = binding.DeepCopy()
+		return nil
+	}, ack)
+	coord.prepare = func(s NativeTerminalSnapshot) {
+		if s.Pod.Annotations["received-resource-type"] != "Fraction" {
+			t.Fatal("ACK prepared before final annotations persisted")
+		}
+		if s.Pod.ResourceVersion == "1" {
+			t.Fatal("ACK used original Pod RV before persisted patch")
+		}
+	}
+	coord.validate = func(s NativeTerminalSnapshot) error {
+		if s.Pod.ResourceVersion == "1" {
+			t.Fatal("current readback used stale RV")
+		}
+		return nil
+	}
+	binder := NewBinder(kube, &nativeTestReservation{}, plugins.New())
+	binder.SetNativeTerminal(kube, "authority", coord)
+	if err := binder.Bind(context.Background(), pod, node, br); err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(coord.calls, []string{"prepare", "validate", "validate-binding", "binding", "bound", "close"}) {
+		t.Fatalf("wrong terminal order %v", coord.calls)
+	}
+	if actualBinding.UID != pod.UID || actualBinding.ResourceVersion == "" || actualBinding.ResourceVersion == "1" || actualBinding.Target.UID != node.UID {
+		t.Fatalf("Binding lacks actual UID/current RV/nodeUID: %+v", actualBinding)
+	}
+}
+
+func TestNativeTerminalRejectsChangedReadbackBeforeBinding(t *testing.T) {
+	for _, change := range []string{"pod-uid", "pod-spec", "request-generation", "node-uid", "ack-version", "mutable-ack"} {
+		t.Run(change, func(t *testing.T) {
+			pod, node, br := nativeTestInputs()
+			pod.Annotations["received-resource-type"] = "Fraction"
+			ack := nativeTestACK(pod)
+			binds := 0
+			kube := nativeTestClient(t, pod, node, br, func(*v1.Binding) error { binds++; return nil }, ack)
+			coord := &nativeTestCoordinator{ack: ack}
+			coord.prepare = func(NativeTerminalSnapshot) {
+				var obj client.Object
+				switch change {
+				case "pod-uid", "pod-spec":
+					current := &v1.Pod{}
+					if err := kube.Get(context.Background(), client.ObjectKeyFromObject(pod), current); err != nil {
+						t.Fatal(err)
+					}
+					if change == "pod-uid" {
+						current.UID = "11111111-2222-4333-8444-555555555559"
+					} else {
+						current.Spec.Containers[0].Image = "foreign"
+					}
+					obj = current
+				case "request-generation":
+					current := br.DeepCopy()
+					current.Generation++
+					obj = current
+				case "node-uid":
+					current := node.DeepCopy()
+					current.UID = "foreign-node"
+					obj = current
+				default:
+					current := ack.DeepCopy()
+					if change == "mutable-ack" {
+						no := false
+						current.Immutable = &no
+					} else {
+						current.Data["allocation.json"] = "changed"
+					}
+					obj = current
+				}
+				if err := kube.Update(context.Background(), obj); err != nil {
+					t.Fatal(err)
+				}
+			}
+			binder := NewBinder(kube, &nativeTestReservation{}, plugins.New())
+			binder.SetNativeTerminal(kube, "authority", coord)
+			if err := binder.bindNativeTerminal(context.Background(), pod, node, br, nativeTestState()); !errors.Is(err, ErrNativeCustodyHeld) {
+				t.Fatalf("changed %s accepted: %v", change, err)
+			}
+			if binds != 0 {
+				t.Fatal("Binding attempted after generation change")
+			}
+			if !reflect.DeepEqual(coord.calls[len(coord.calls)-2:], []string{"hold", "close"}) {
+				t.Fatalf("fence released before durable hold: %v", coord.calls)
+			}
+		})
+	}
+}
+
+func TestNativeTerminalCancellationAndLostBindingResponseHoldBeforeClose(t *testing.T) {
+	for _, mode := range []string{"cancel-before-bind", "lost-bind-response", "sdk-denial"} {
+		t.Run(mode, func(t *testing.T) {
+			pod, node, br := nativeTestInputs()
+			pod.Annotations["received-resource-type"] = "Fraction"
+			ack := nativeTestACK(pod)
+			coord := &nativeTestCoordinator{ack: ack}
+			binds := 0
+			kube := nativeTestClient(t, pod, node, br, func(*v1.Binding) error { binds++; return errors.New("lost response") }, ack)
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			coord.validate = func(NativeTerminalSnapshot) error {
+				if mode == "cancel-before-bind" {
+					cancel()
+				}
+				if mode == "sdk-denial" {
+					return errors.New("full SDK authority comparison denied")
+				}
+				return nil
+			}
+			binder := NewBinder(kube, &nativeTestReservation{}, plugins.New())
+			binder.SetNativeTerminal(kube, "authority", coord)
+			if err := binder.bindNativeTerminal(ctx, pod, node, br, nativeTestState()); !errors.Is(err, ErrNativeCustodyHeld) {
+				t.Fatal(err)
+			}
+			if mode != "lost-bind-response" && binds != 0 {
+				t.Fatal("denied/cancelled attempt bound")
+			}
+			if !reflect.DeepEqual(coord.calls[len(coord.calls)-2:], []string{"hold", "close"}) {
+				t.Fatalf("hold lost/reordered on cancellation: %v", coord.calls)
+			}
+		})
+	}
+}
+
+func TestNativeTerminalCancellationUsesExactPodUIDAndCurrentRV(t *testing.T) {
+	pod, node, br := nativeTestInputs()
+	coord := &nativeTestCoordinator{}
+	kube := nativeTestClient(t, pod, node, br, func(*v1.Binding) error { t.Fatal("unexpected Binding"); return nil })
+	var preconditions *metav1.Preconditions
+	wrapped := interceptor.NewClient(kube, interceptor.Funcs{Delete: func(ctx context.Context, c client.WithWatch, obj client.Object, opts ...client.DeleteOption) error {
+		options := &client.DeleteOptions{}
+		for _, opt := range opts {
+			opt.ApplyToDelete(options)
+		}
+		preconditions = options.Preconditions
+		return c.Delete(ctx, obj, opts...)
+	}})
+	binder := NewBinder(wrapped, &nativeTestReservation{}, plugins.New())
+	binder.SetNativeTerminal(kube, "authority", coord)
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if err := binder.Rollback(ctx, pod, node, br); !errors.Is(err, ErrNativeCustodyHeld) {
+		t.Fatal(err)
+	}
+	if preconditions == nil || preconditions.UID == nil || *preconditions.UID != pod.UID || preconditions.ResourceVersion == nil || *preconditions.ResourceVersion != "1" {
+		t.Fatalf("unguarded cancellation %+v", preconditions)
+	}
+	if !reflect.DeepEqual(coord.calls, []string{"hold"}) {
+		t.Fatalf("cleanup ran before absence/native-zero proof: %v", coord.calls)
+	}
+}
+
+func TestNativeTerminalCleanupRequiresNativeZeroAndExactMapUIDs(t *testing.T) {
+	for _, mode := range []string{"native-not-zero", "replaced-map", "exact-cleanup"} {
+		t.Run(mode, func(t *testing.T) {
+			old, node, br := nativeTestInputs()
+			replacement := old.DeepCopy()
+			replacement.UID = "11111111-2222-4333-8444-555555555559"
+			prefix := old.Annotations["runai/shared-gpu-configmap"]
+			yes := true
+			maps := []v1.ConfigMap{}
+			for index, suffix := range []string{"-0", "-0-evar"} {
+				maps = append(maps, v1.ConfigMap{ObjectMeta: metav1.ObjectMeta{Name: prefix + suffix, Namespace: old.Namespace, UID: types.UID(fmt.Sprintf("11111111-2222-4333-8444-55555555556%d", index)), ResourceVersion: "7", OwnerReferences: []metav1.OwnerReference{{APIVersion: "v1", Kind: "Pod", Name: old.Name, UID: old.UID}}}, Immutable: &yes})
+			}
+			actualMaps := []client.Object{maps[0].DeepCopy(), maps[1].DeepCopy()}
+			if mode == "replaced-map" {
+				actualMaps[0].SetUID("replacement-map-uid")
+			}
+			coord := &nativeTestCoordinator{maps: maps}
+			if mode == "native-not-zero" {
+				coord.cleanupErr = errors.New("native zero not confirmed")
+			}
+			kube := nativeTestClient(t, replacement, node, br, func(*v1.Binding) error { return nil }, actualMaps...)
+			deletes := 0
+			wrapped := interceptor.NewClient(kube, interceptor.Funcs{Delete: func(ctx context.Context, c client.WithWatch, obj client.Object, opts ...client.DeleteOption) error {
+				if _, ok := obj.(*v1.Pod); ok {
+					t.Fatal("replacement Pod was deleted")
+				}
+				options := &client.DeleteOptions{}
+				for _, opt := range opts {
+					opt.ApplyToDelete(options)
+				}
+				if options.Preconditions == nil || options.Preconditions.UID == nil || *options.Preconditions.UID != obj.GetUID() || options.Preconditions.ResourceVersion == nil || *options.Preconditions.ResourceVersion != obj.GetResourceVersion() {
+					t.Fatal("map deletion lacks current exact UID/RV")
+				}
+				deletes++
+				return c.Delete(ctx, obj, opts...)
+			}})
+			rrs := &nativeTestReservation{}
+			binder := NewBinder(wrapped, rrs, plugins.New())
+			binder.SetNativeTerminal(kube, "authority", coord)
+			err := binder.Rollback(context.Background(), old, node, br)
+			if mode == "exact-cleanup" {
+				if err != nil || deletes != 2 {
+					t.Fatalf("exact cleanup failed %v deletes=%d", err, deletes)
+				}
+			} else {
+				if !errors.Is(err, ErrNativeCustodyHeld) || deletes != 0 {
+					t.Fatalf("ambiguous cleanup proceeded %v deletes=%d", err, deletes)
+				}
+			}
+			if rrs.removed != 0 {
+				t.Fatal("old name-based Pod labels patched")
+			}
+		})
+	}
+}
+
+func TestNativeTerminalRejectsWithoutCoordinator(t *testing.T) {
+	pod, node, br := nativeTestInputs()
+	binds := 0
+	kube := nativeTestClient(t, pod, node, br, func(*v1.Binding) error { binds++; return nil })
+	binder := NewBinder(kube, &nativeTestReservation{}, plugins.New())
+	if err := binder.Bind(context.Background(), pod, node, br); err == nil {
+		t.Fatal("opt-in Pod bound without terminal coordinator/ACK")
+	}
+	if binds != 0 {
+		t.Fatalf("Binding attempted %d times without ACK", binds)
+	}
+}
