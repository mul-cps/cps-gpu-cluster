+)
+
+type nativeTestCustody struct {
+	allowed bool
+	err     error
+	calls   int
+}
+
+func (g *nativeTestCustody) MayDeleteReservation(context.Context, *v1.Pod) (bool, error) {
+	g.calls++
+	return g.allowed, g.err
+}
+
+func TestNativeReservationCustodyHoldsAndExactDeletion(t *testing.T) {
+	for _, mode := range []string{"pod-exists-hold", "native-zero-unknown", "exact-release", "replaced-reservation"} {
+		t.Run(mode, func(t *testing.T) {
+			pod := &v1.Pod{ObjectMeta: metav1.ObjectMeta{Name: "reservation", Namespace: "kai", UID: "11111111-2222-4333-8444-555555555555", ResourceVersion: "7"}, Status: v1.PodStatus{Phase: v1.PodFailed}}
+			actual := pod.DeepCopy()
+			if mode == "replaced-reservation" {
+				actual.UID = "11111111-2222-4333-8444-555555555559"
+			}
+			deletes := 0
+			kube := fake.NewClientBuilder().WithObjects(actual).WithInterceptorFuncs(interceptor.Funcs{Delete: func(ctx context.Context, c client.WithWatch, obj client.Object, opts ...client.DeleteOption) error {
+				options := &client.DeleteOptions{}
+				for _, opt := range opts {
+					opt.ApplyToDelete(options)
+				}
+				if options.Preconditions == nil || options.Preconditions.UID == nil || *options.Preconditions.UID != pod.UID || options.Preconditions.ResourceVersion == nil || *options.Preconditions.ResourceVersion != pod.ResourceVersion {
+					t.Fatal("reservation deletion missing UID/RV preconditions")
+				}
+				deletes++
+				return c.Delete(ctx, obj, opts...)
+			}}).Build()
+			guard := &nativeTestCustody{allowed: mode == "exact-release" || mode == "replaced-reservation"}
+			if mode == "native-zero-unknown" {
+				guard.err = errors.New("native zero unresolved")
+			}
+			rsc := &service{kubeClient: kube}
+			rsc.SetNativeCustody(kube, guard)
+			if !rsc.NativeCustodyEnabled() {
+				t.Fatal("guard not configured")
+			}
+			err := rsc.deleteReservationPod(context.Background(), pod)
+			expectedCalls := 1
+			if mode == "replaced-reservation" {
+				expectedCalls = 0
+			}
+			if guard.calls != expectedCalls {
+				t.Fatalf("custody queried %d times", guard.calls)
+			}
+			if mode == "exact-release" {
+				if err != nil || deletes != 1 {
+					t.Fatalf("exact release failed %v deletes=%d", err, deletes)
+				}
+			} else {
+				if mode == "pod-exists-hold" && (err != nil || deletes != 0) {
+					t.Fatalf("hold deleted reservation %v deletes=%d", err, deletes)
+				}
+				if mode == "native-zero-unknown" && (err == nil || deletes != 0) {
+					t.Fatalf("unknown zero released reservation %v deletes=%d", err, deletes)
+				}
+				if mode == "replaced-reservation" && err == nil {
+					t.Fatal("replaced reservation deletion succeeded")
+				}
+				if getErr := kube.Get(context.Background(), client.ObjectKeyFromObject(actual), &v1.Pod{}); getErr != nil {
+					t.Fatalf("reservation lost despite hold/replace %v", getErr)
+				}
+			}
+		})
+	}
+}
