+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestNativeHTTPDisabledDoesNotReadCredentials(t *testing.T) {
+	bridge, err := NewNativeHTTP(NativeHTTPConfig{Enabled: false, URL: "invalid", TokenFile: "/not-read", CAFile: "/not-read"})
+	if err != nil || bridge != nil {
+		t.Fatalf("disabled bridge activated: %v", err)
+	}
+}
+
+func nativeTransportFixture(t *testing.T, handler http.HandlerFunc) (*NativeHTTP, string) {
+	t.Helper()
+	server := httptest.NewTLSServer(handler)
+	t.Cleanup(server.Close)
+	directory := t.TempDir()
+	token := filepath.Join(directory, "projected-token")
+	ca := filepath.Join(directory, "ca.crt")
+	if err := os.WriteFile(token, []byte("unit.header.signature"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(ca, pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: server.Certificate().Raw}), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	bridge, err := NewNativeHTTP(NativeHTTPConfig{Enabled: true, URL: server.URL, AuthorityNamespace: "authority", TokenFile: token, CAFile: ca})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return bridge, token
+}
+
+func TestNativeHTTPClosedWireFlowAndTokenRotation(t *testing.T) {
+	pod, node, br := nativeTestInputs()
+	pod.Annotations["received-resource-type"] = "Fraction"
+	ack := nativeTestACK(pod)
+	operations := []string{}
+	bridge, token := nativeTransportFixture(t, func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != "POST" || !strings.HasPrefix(r.URL.Path, "/api/native-kai/v1/") {
+			t.Errorf("unexpected route %s %s", r.Method, r.URL.Path)
+		}
+		var body map[string]interface{}
+		if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+			t.Error(err)
+		}
+		op := strings.TrimPrefix(r.URL.Path, "/api/native-kai/v1/")
+		operations = append(operations, op)
+		if body["protocol"] != "cps-native-kai-terminal/v1" || body["operation"] != op || body["request_id"] == "" {
+			t.Error("closed envelope missing identity")
+		}
+		expectedToken := "unit.header.signature"
+		if len(operations) > 1 {
+			expectedToken = "rotated.header.signature"
+		}
+		if r.Header.Get("Authorization") != "Bearer "+expectedToken {
+			t.Error("projected token not freshly loaded")
+		}
+		response := map[string]interface{}{"protocol": body["protocol"], "operation": op, "request_id": body["request_id"]}
+		if op == "prepare" {
+			response["fence_id"] = "aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee"
+			response["ack"] = ack
+		}
+		w.Header().Set("Content-Type", "application/json")
+		json.NewEncoder(w).Encode(response)
+	})
+	snapshot := NativeTerminalSnapshot{Pod: pod, Node: node, BindRequest: br, BindingState: nativeTestState()}
+	fence, err := bridge.Prepare(context.Background(), snapshot)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(token, []byte("rotated.header.signature"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := fence.ValidateCurrent(context.Background(), snapshot, ack); err != nil {
+		t.Fatal(err)
+	}
+	fence.Close()
+	if len(operations) != 3 || operations[0] != "prepare" || operations[1] != "current" || operations[2] != "close" {
+		t.Fatalf("wrong operations %v", operations)
+	}
+}
+
+func TestNativeHTTPRejectsRedirectAndMalformedClosedResponses(t *testing.T) {
+	for _, mode := range []string{"redirect", "wrong-id", "extra-field", "duplicate-field", "oversize"} {
+		t.Run(mode, func(t *testing.T) {
+			calls := 0
+			bridge, _ := nativeTransportFixture(t, func(w http.ResponseWriter, r *http.Request) {
+				calls++
+				var body map[string]interface{}
+				json.NewDecoder(r.Body).Decode(&body)
+				if mode == "redirect" {
+					http.Redirect(w, r, "https://foreign.example.invalid/token-target", http.StatusTemporaryRedirect)
+					return
+				}
