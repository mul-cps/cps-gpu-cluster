+			kube := nativeTestClient(t, pod, node, br, func(*v1.Binding) error { return nil }, registry, seed, ack)
+			coord := &nativeTestCoordinator{ack: ack}
+			coord.prepare = func(NativeTerminalSnapshot) {
+				cm := &v1.ConfigMap{}
+				if err := kube.Get(context.Background(), client.ObjectKey{Namespace: pod.Namespace, Name: pod.Annotations["runai/shared-gpu-configmap"] + "-0"}, cm); err != nil {
+					t.Fatal(err)
+				}
+				if !reflect.DeepEqual(cm.Data, map[string]string{"CUDA_DEVICE_MEMORY_LIMIT": fmt.Sprintf("%dm", item.gib*1024), "GPU_PORTION": item.portion, "RUNAI_NUM_OF_GPUS": item.portion, "NVIDIA_VISIBLE_DEVICES": "k8s.device-plugin.nvidia.com/gpu=" + nativeApprovedGPU}) {
+					t.Fatalf("exact native cap lost to rounded scheduler portion: %v", cm.Data)
+				}
+			}
+			ps := plugins.New()
+			ps.RegisterPlugin(gpusharing.New(kube, true, false))
+			ps.RegisterPlugin(hamicore.New(kube))
+			binder := NewBinder(kube, &nativeTestReservation{}, ps)
+			binder.SetNativeTerminal(kube, "authority", coord)
+			if err := binder.Bind(context.Background(), pod, node, br); err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
+
+func TestNativeMemoryProducerRejectsUntrustedCompilerCapBeforeWrites(t *testing.T) {
+	for _, fault := range []string{"unknown-profile", "profile-mismatch", "memory", "container-memory", "container-name", "source-name", "seed-attempt", "live-only"} {
+		t.Run(fault, func(t *testing.T) {
+			pod, node, br := nativeTestInputs()
+			pod.Namespace = "jupyterhub"
+			br.Namespace = pod.Namespace
+			registry, seed := nativeRegistryFixtures(pod)
+			var reg, document map[string]interface{}
+			_ = json.Unmarshal([]byte(registry.Data["registry.json"]), &reg)
+			_ = json.Unmarshal([]byte(seed.Data["seed.json"]), &document)
+			admitted := document["admitted"].(map[string]interface{})
+			annotations := admitted["metadata"].(map[string]interface{})["annotations"].(map[string]interface{})
+			switch fault {
+			case "unknown-profile":
+				reg["profile"] = "arbitrary"
+			case "profile-mismatch":
+				reg["profile"] = "interactive-shared-10"
+			case "memory":
+				annotations["gpu-memory"] = "5324"
+			case "container-memory":
+				annotations["nvidia.com/container.notebook.gpu-memory.request"] = "5324Mi"
+			case "container-name":
+				annotations["gpu-fraction-container-name"] = "other"
+			case "source-name":
+				document["source_pod"].(map[string]interface{})["metadata"].(map[string]interface{})["name"] = "other"
+			case "seed-attempt":
+				document["attempt"] = "11111111-2222-4333-8444-555555555500"
+			case "live-only":
+				delete(annotations, "gpu-memory")
+				pod.Annotations["gpu-memory"] = "5120"
+			}
+			raw, _ := json.Marshal(reg)
+			registry.Data["registry.json"] = string(raw)
+			raw, _ = json.Marshal(document)
+			seed.Data["seed.json"] = string(raw)
+			kube := nativeTestClient(t, pod, node, br, func(*v1.Binding) error { t.Fatal("unexpected Bind"); return nil }, registry, seed)
+			reservation := &nativeCountingReservation{}
+			binder := NewBinder(kube, reservation, plugins.New())
+			binder.SetNativeTerminal(kube, "authority", &nativeTestCoordinator{})
+			err := binder.Bind(context.Background(), pod, node, br)
+			cms := &v1.ConfigMapList{}
+			_ = kube.List(context.Background(), cms, client.InNamespace(pod.Namespace))
+			if !errors.Is(err, ErrNativeCustodyHeld) || reservation.syncs != 0 || len(cms.Items) != 0 {
+				t.Fatalf("untrusted cap reached side effects: %v sync%d maps%d", err, reservation.syncs, len(cms.Items))
+			}
+		})
+	}
+}
+
+func TestLegacyNativeRegistryKeepsStockMemoryScalar(t *testing.T) {
+	pod, node, br := nativeTestInputs()
+	kube := nativeTestClient(t, pod, node, br, func(*v1.Binding) error { return nil })
+	registry := &v1.ConfigMap{}
+	if err := kube.Get(context.Background(), client.ObjectKey{Namespace: "authority", Name: "cps-pending-registry-" + string(pod.UID)}, registry); err != nil {
+		t.Fatal(err)
