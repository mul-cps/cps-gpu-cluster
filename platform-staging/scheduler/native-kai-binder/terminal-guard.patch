+package app
+
+import (
+	"github.com/spf13/pflag"
+	"testing"
+)
+
+func TestNativeCoordinatorOptionsAreExplicitAndDisabledByDefault(t *testing.T) {
+	flags := pflag.NewFlagSet("native-offline", pflag.ContinueOnError)
+	options := InitOptions(flags)
+	if options.NativeCoordinator.Enabled || options.NativeCoordinator.URL != "" || options.NativeCoordinator.TokenFile != "" || options.NativeCoordinator.CAFile != "" || options.NativeCoordinator.AuthorityNamespace != "" {
+		t.Fatal("native coordinator was implicitly configured")
+	}
+	if err := flags.Parse([]string{"--native-pending-coordinator-enabled", "--native-coordinator-url=https://coordinator.example.invalid", "--native-coordinator-authority-namespace=authority", "--native-coordinator-token-file=/not-read", "--native-coordinator-ca-file=/not-read"}); err != nil {
+		t.Fatal(err)
+	}
+	if !options.NativeCoordinator.Enabled || options.NativeCoordinator.URL != "https://coordinator.example.invalid" {
+		t.Fatal("explicit native options not retained")
+	}
+}
