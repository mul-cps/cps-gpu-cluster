+func uid(index int) string    { return fmt.Sprintf("%08d-1111-4111-8111-%012d", index, index) }
+func encode(value any) string { raw, _ := json.Marshal(value); return string(raw) }
+func hash(value any) string {
+	raw, _ := json.Marshal(value)
+	sum := sha256.Sum256(raw)
+	return "sha256:" + hex.EncodeToString(sum[:])
+}
+func reference(namespace, name, key string, index int) map[string]any {
+	return map[string]any{"namespace": namespace, "name": name, "uid": uid(index), "resourceVersion": "10", "key": key, "data_sha256": "sha256:" + fmt.Sprintf("%064d", index)}
+}
