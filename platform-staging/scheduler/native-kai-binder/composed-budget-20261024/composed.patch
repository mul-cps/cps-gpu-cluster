diff --git a/pkg/scheduler/plugins/nativequalifiedbudget/accounting.go b/pkg/scheduler/plugins/nativequalifiedbudget/accounting.go
new file mode 100644
index 0000000..c5967f9
--- /dev/null
+++ b/pkg/scheduler/plugins/nativequalifiedbudget/accounting.go
@@ -0,0 +1,228 @@
+// Copyright 2026 NVIDIA CORPORATION
+// SPDX-License-Identifier: Apache-2.0
+
+package nativequalifiedbudget
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+
+	v1 "k8s.io/api/core/v1"
+
+	"github.com/kai-scheduler/KAI-scheduler/pkg/scheduler/api/node_info"
+	"github.com/kai-scheduler/KAI-scheduler/pkg/scheduler/api/pod_info"
+)
+
+type usage struct{ memory, count int64 }
+type reservationVersion struct {
+	ref   versionRef
+	group string
+}
+
+func (u usage) plus(capMiB int64) usage { return usage{u.memory + capMiB, u.count + 1} }
+
+type accounting struct {
+	known                      map[string]usage
+	groups                     map[string]string
+	unknown                    map[string]usage
+	unknownProfiles            map[string]map[string]int64
+	slots, foreign, unresolved map[string]bool
+	claims                     map[string]claim
+	reservations               []reservationVersion
+}
+type cachedAccounting struct {
+	podUID string
+	state  *accounting
+	err    error
+}
+
+func matchesTask(r *requestDocument, task *pod_info.PodInfo) bool {
+	return task != nil && task.Pod != nil && r.Pod.UID == string(task.UID) && r.Pod.UID == string(task.Pod.UID) && r.Pod.Namespace == task.Namespace && r.Pod.Namespace == task.Pod.Namespace && r.Pod.Name == task.Name && r.Pod.Name == task.Pod.Name && task.Pod.Annotations[marker] == "v2" && task.Pod.Annotations[pendingHash] == r.PendingHash && task.Pod.Annotations["gpu-memory"] == strconv.FormatInt(r.CapMiB, 10) && task.IsGpuMemoryRequest() && task.GpuRequirement.GetNumOfGpuDevices() == 1 && task.GpuRequirement.GpuMemory() == r.CapMiB && task.RequestedGPUComputeSharingMode() == "time-slicing"
+}
+
+func buildAccounting(p *provider, view *nodeView, node *node_info.NodeInfo, candidate *pod_info.PodInfo) (*accounting, error) {
+	a := &accounting{known: map[string]usage{}, groups: map[string]string{}, unknown: map[string]usage{}, unknownProfiles: map[string]map[string]int64{}, slots: map[string]bool{}, foreign: map[string]bool{}, unresolved: map[string]bool{}, claims: map[string]claim{}}
+	runtimeIDs := map[string]string{}
+	for _, device := range view.budget.Devices {
+		runtimeIDs[device.RuntimeID] = device.UUID
+	}
+	physicalGroups := map[string]string{}
+	for _, task := range node.PodInfos {
+		pod := task.Pod
+		if pod == nil || pod.Namespace != p.opts.reservationNS || !strings.HasPrefix(pod.Name, "gpu-reservation") {
+			continue
+		}
+		group := pod.Labels["runai-gpu-group"]
+		if !validNamespace(group) || !validUID(string(pod.UID)) || !rvPattern.MatchString(pod.ResourceVersion) || pod.DeletionTimestamp != nil || pod.Spec.NodeName != node.Name || pod.Spec.ServiceAccountName != p.opts.reservationSA {
+			return nil, fmt.Errorf("live trusted reservation Pod required")
+		}
+		if len(pod.Spec.Containers) != 1 || len(pod.Spec.InitContainers) != 0 || len(pod.Spec.EphemeralContainers) != 0 {
+			return nil, fmt.Errorf("one actual whole-device reservation container required")
+		}
+		requested, hasRequest := pod.Spec.Containers[0].Resources.Requests["nvidia.com/gpu"]
+		limited, hasLimit := pod.Spec.Containers[0].Resources.Limits["nvidia.com/gpu"]
+		requestCount, requestInteger := requested.AsInt64()
+		limitCount, limitInteger := limited.AsInt64()
+		if !hasRequest || !hasLimit || !requestInteger || !limitInteger || requestCount != 1 || limitCount != 1 {
+			return nil, fmt.Errorf("one actual reserved physical GPU required")
+		}
+		if _, ok := a.groups[group]; ok || a.unresolved[group] {
+			return nil, fmt.Errorf("ambiguous reservation group")
+		}
+		actual, err := p.pods.Pods(pod.Namespace).Get(pod.Name)
+		if err != nil || podVersion(actual) != podVersion(pod) || actual.DeletionTimestamp != nil || !p.reservationCurrent(podVersion(pod), group) {
+			return nil, fmt.Errorf("reservation Pod changed")
+		}
+		a.reservations = append(a.reservations, reservationVersion{podVersion(pod), group})
+		id := pod.Annotations[reservationDevice]
+		if id == "" {
+			a.unresolved[group] = true
+			a.slots[group] = true
+			continue
+		}
+		physical, ok := runtimeIDs[id]
+		if !ok || pod.Status.Phase != v1.PodRunning {
+			return nil, fmt.Errorf("reserved device absent from qualified inventory")
+		}
+		if other, ok := physicalGroups[physical]; ok && other != group {
+			return nil, fmt.Errorf("physical device has conflicting reservation groups")
+		}
+		a.groups[group] = physical
+		physicalGroups[physical] = group
+	}
+	for _, entry := range view.claims.Claims {
+		if _, exists := a.claims[entry.Pod.UID]; exists {
+			continue
+		} // Exact duplicates were checked by the provider.
+		a.claims[entry.Pod.UID] = entry
+		a.known[entry.UUID] = a.known[entry.UUID].plus(entry.CapMiB)
+	}
+	for _, task := range node.PodInfos {
+		if task.Pod == nil || task.Pod.Namespace == p.opts.reservationNS && strings.HasPrefix(task.Pod.Name, "gpu-reservation") {
+			continue
+		}
+		if !task.IsSharedGPUAllocation() {
+			continue
+		}
+		groups := task.GPUGroupIDs()
+		if len(groups) == 0 {
+			continue
+		}
+		if len(groups) != 1 {
+			return nil, fmt.Errorf("single-device native/ordinary group accounting required")
+		}
+		group := groups[0]
+		if !validNamespace(group) {
+			return nil, fmt.Errorf("canonical GPU group required")
+		}
+		physical, known := a.groups[group]
+		if !known {
+			a.slots[group] = true
+		}
+		if task.Pod.Annotations[marker] != "v2" {
+			a.foreign[group] = true
+			continue
+		}
+		if held, exists := a.claims[string(task.UID)]; exists {
+			if held.Pod.Name != task.Name || held.Pod.Namespace != task.Namespace || known && held.UUID != physical {
+				return nil, fmt.Errorf("retained claim and actual placement disagree")
+			}
+			if !known {
+				a.unresolved[group] = true
+			}
+			continue
+		}
+		request, exists := p.requests[string(task.UID)]
+		if !exists || !matchesTask(request.body, task) {
+			return nil, fmt.Errorf("assigned native task lacks retained request accounting")
+		}
+		if task.UID == candidate.UID {
+			continue
+		} // Re-evaluation replaces only this provisional placement.
+		if known {
+			a.known[physical] = a.known[physical].plus(request.body.CapMiB)
+		} else {
+			a.unknown[group] = a.unknown[group].plus(request.body.CapMiB)
+			if a.unknownProfiles[group] == nil {
+				a.unknownProfiles[group] = map[string]int64{}
+			}
+			if previous, ok := a.unknownProfiles[group][request.body.Profile]; ok && previous != request.body.CapMiB {
+				return nil, fmt.Errorf("conflicting unresolved profile caps")
+			}
+			a.unknownProfiles[group][request.body.Profile] = request.body.CapMiB
+		}
+	}
+	return a, nil
+}
+
+func fits(device deviceBudget, base, demand usage) bool {
+	return base.memory <= device.BudgetMiB && base.count <= device.MaxWorkspaces && demand.memory <= device.BudgetMiB-base.memory && demand.count <= device.MaxWorkspaces-base.count
+}
+
+func (a *accounting) fits(view *nodeView, task *pod_info.PodInfo, request requestDocument, group string) bool {
+	if a.foreign[group] || a.unresolved[group] {
+		return false
+	}
+	held, isHeld := a.claims[string(task.UID)]
+	if isHeld && held.State != "active" {
+		return false
+	}
+	if physical, known := a.groups[group]; known {
+		if isHeld {
+			return held.UUID == physical && held.Attempt == request.Attempt && held.CapMiB == request.CapMiB
+		}
+		for _, device := range view.budget.Devices {
+			if device.UUID == physical {
+				return fits(device, a.known[physical], usage{request.CapMiB, 1})
+			}
+		}
+		return false
+	}
+	if isHeld {
+		return false
+	} // A committed selection cannot be silently reselected.
+	if group != pod_info.WholeGpuIndicator {
+		if _, exists := a.unknown[group]; !exists {
+			return false
+		}
+	}
+	reserved := map[string]bool{}
+	for _, physical := range a.groups {
+		reserved[physical] = true
+	}
+	available := []deviceBudget{}
+	for _, device := range view.budget.Devices {
+		if !reserved[device.UUID] {
+			available = append(available, device)
+		}
+	}
+	slots := len(a.slots)
+	if group == pod_info.WholeGpuIndicator {
+		slots++
+	}
+	if len(available) == 0 || slots > len(available) {
+		return false
+	}
+	demands := map[string]usage{}
+	for id, value := range a.unknown {
+		demands[id] = value
+	}
+	demands[group] = demands[group].plus(request.CapMiB)
+	for id, demand := range demands {
+		for _, device := range available {
+			if !fits(device, a.known[device.UUID], demand) {
+				return false
+			}
+			for profile, capMiB := range a.unknownProfiles[id] {
+				if device.Profiles[profile] != capMiB {
+					return false
+				}
+			}
+			if id == group && device.Profiles[request.Profile] != request.CapMiB {
+				return false
+			}
+		}
+	}
+	return true
+}
diff --git a/pkg/scheduler/plugins/nativequalifiedbudget/contract.go b/pkg/scheduler/plugins/nativequalifiedbudget/contract.go
new file mode 100644
index 0000000..9f853d3
--- /dev/null
+++ b/pkg/scheduler/plugins/nativequalifiedbudget/contract.go
@@ -0,0 +1,331 @@
+// Copyright 2026 NVIDIA CORPORATION
+// SPDX-License-Identifier: Apache-2.0
+
+package nativequalifiedbudget
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"io"
+	"reflect"
+	"regexp"
+	"strconv"
+	"time"
+
+	"k8s.io/apimachinery/pkg/util/validation"
+
+	"github.com/kai-scheduler/KAI-scheduler/pkg/scheduler/framework"
+)
+
+const Name = "nativequalifiedbudget"
+const marker = "cps.compute/native-pool-pending"
+const pendingHash = "cps.compute/native-pool-unplaced-sha256"
+const reservationDevice = "run.ai/reserve_for_gpu_index"
+const maxRecords = 4096
+
+var uuidPattern = regexp.MustCompile(`^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$`)
+var digestPattern = regexp.MustCompile(`^sha256:[0-9a-f]{64}$`)
+var bareDigestPattern = regexp.MustCompile(`^[0-9a-f]{64}$`)
+var rvPattern = regexp.MustCompile(`^[1-9][0-9]*$`)
+var runtimePattern = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$`)
+var keyPattern = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9_.-]{0,252}$`)
+
+type immutableRef struct {
+	Namespace string `json:"namespace"`
+	Name      string `json:"name"`
+	UID       string `json:"uid"`
+	RV        string `json:"resourceVersion"`
+	DataSHA   string `json:"data_sha256"`
+	Key       string `json:"key"`
+}
+
+func validUID(value string) bool {
+	return uuidPattern.MatchString(value) && value != "00000000-0000-0000-0000-000000000000"
+}
+func validNamespace(value string) bool { return len(validation.IsDNS1123Label(value)) == 0 }
+func validName(value string) bool      { return len(validation.IsDNS1123Subdomain(value)) == 0 }
+func (r immutableRef) valid() bool {
+	return validNamespace(r.Namespace) && validName(r.Name) && validUID(r.UID) && rvPattern.MatchString(r.RV) && digestPattern.MatchString(r.DataSHA) && r.DataSHA != "sha256:"+string(bytes.Repeat([]byte{'0'}, 64)) && keyPattern.MatchString(r.Key)
+}
+func canonicalHash(value any) string {
+	raw, _ := json.Marshal(value)
+	sum := sha256.Sum256(raw)
+	return "sha256:" + hex.EncodeToString(sum[:])
+}
+func (r immutableRef) canonicalHash() string {
+	return canonicalHash(map[string]string{"namespace": r.Namespace, "name": r.Name, "uid": r.UID, "resourceVersion": r.RV, "data_sha256": r.DataSHA, "key": r.Key})
+}
+
+type objectRef struct {
+	Namespace string `json:"namespace"`
+	Name      string `json:"name"`
+	UID       string `json:"uid"`
+}
+
+func (r objectRef) valid() bool {
+	return validNamespace(r.Namespace) && validName(r.Name) && validUID(r.UID)
+}
+
+type deviceBudget struct {
+	UUID          string           `json:"gpu_uuid"`
+	RuntimeID     string           `json:"runtime_id"`
+	MemoryMiB     int64            `json:"total_memory_mib"`
+	BudgetMiB     int64            `json:"budget_mib"`
+	MaxWorkspaces int64            `json:"max_workspaces"`
+	Profiles      map[string]int64 `json:"profiles"`
+	Qualification immutableRef     `json:"qualification_ref"`
+}
+type nodeBudget struct {
+	Name             string         `json:"node"`
+	UID              string         `json:"node_uid"`
+	BootID           string         `json:"boot_id"`
+	DriverGeneration string         `json:"driver_generation"`
+	ClaimsRef        objectRef      `json:"claims_ref"`
+	Devices          []deviceBudget `json:"devices"`
+}
+type budgetDocument struct {
+	Protocol   string       `json:"protocol"`
+	Version    int          `json:"version"`
+	Catalog    immutableRef `json:"catalog_ref"`
+	PolicyHash string       `json:"policy_hash"`
+	Nodes      []nodeBudget `json:"nodes"`
+}
+type claim struct {
+	Attempt string    `json:"attempt"`
+	Pod     objectRef `json:"pod"`
+	UUID    string    `json:"gpu_uuid"`
+	CapMiB  int64     `json:"cap_mib"`
+	State   string    `json:"state"`
+}
+type claimsDocument struct {
+	Protocol         string       `json:"protocol"`
+	Version          int          `json:"version"`
+	Projection       immutableRef `json:"projection_ref"`
+	Node             string       `json:"node"`
+	NodeUID          string       `json:"node_uid"`
+	BootID           string       `json:"boot_id"`
+	DriverGeneration string       `json:"driver_generation"`
+	Issued           time.Time    `json:"issued_at"`
+	Expires          time.Time    `json:"expires_at"`
+	Claims           []claim      `json:"claims"`
+}
+type requestDocument struct {
+	Protocol     string       `json:"protocol"`
+	Version      int          `json:"version"`
+	Pod          objectRef    `json:"pod"`
+	Attempt      string       `json:"attempt"`
+	Profile      string       `json:"profile"`
+	CapMiB       int64        `json:"cap_mib"`
+	PendingHash  string       `json:"pending_spec_sha256"`
+	PolicyHash   string       `json:"policy_hash"`
+	Catalog      immutableRef `json:"catalog_ref"`
+	Source       immutableRef `json:"source_ref"`
+	HeadRevision string       `json:"head_revision"`
+	Deadline     time.Time    `json:"authorization_deadline"`
+}
+type options struct {
+	enabled                                           bool
+	budget                                            immutableRef
+	requestNS, claimsNS, reservationNS, reservationSA string
+	maxAge                                            time.Duration
+}
+
+func parseOptions(args framework.PluginArguments) (options, error) {
+	var result options
+	allowed := map[string]bool{"enabled": true, "budgetReference": true, "requestNamespace": true, "claimsNamespace": true, "reservationNamespace": true, "reservationServiceAccount": true, "maxSnapshotAgeSeconds": true}
+	for key := range args {
+		if !allowed[key] {
+			return result, fmt.Errorf("unknown native budget option")
+		}
+	}
+	if args["enabled"] == "" || args["enabled"] == "false" {
+		return result, nil
+	}
+	if args["enabled"] != "true" {
+		return result, fmt.Errorf("explicit native budget enable boolean required")
+	}
+	result.enabled = true
+	if err := decode(args["budgetReference"], &result.budget); err != nil || !result.budget.valid() || result.budget.Key != "budget.json" {
+		return result, fmt.Errorf("pinned Root budget reference required")
+	}
+	result.requestNS, result.claimsNS = args["requestNamespace"], args["claimsNamespace"]
+	result.reservationNS, result.reservationSA = args["reservationNamespace"], args["reservationServiceAccount"]
+	if !validNamespace(result.requestNS) || !validNamespace(result.claimsNS) || result.requestNS == result.claimsNS || !validNamespace(result.reservationNS) || !validNamespace(result.reservationSA) {
+		return result, fmt.Errorf("distinct trusted request/claim namespaces and reservation identity required")
+	}
+	seconds, err := strconv.Atoi(args["maxSnapshotAgeSeconds"])
+	if err != nil || seconds < 1 || seconds > 300 {
+		return result, fmt.Errorf("bounded native snapshot age required")
+	}
+	result.maxAge = time.Duration(seconds) * time.Second
+	return result, nil
+}
+
+func decode(raw string, result any) error {
+	if len(raw) == 0 || len(raw) > 1048576 {
+		return fmt.Errorf("bounded native budget JSON required")
+	}
+	tokens := json.NewDecoder(bytes.NewBufferString(raw))
+	tokens.UseNumber()
+	if err := uniqueValue(tokens, 0); err != nil {
+		return err
+	}
+	if _, err := tokens.Token(); err != io.EOF {
+		return fmt.Errorf("one native JSON document required")
+	}
+	d := json.NewDecoder(bytes.NewBufferString(raw))
+	d.DisallowUnknownFields()
+	if err := d.Decode(result); err != nil {
+		return err
+	}
+	return exactFields(json.RawMessage(raw), reflect.TypeOf(result).Elem())
+}
+
+// encoding/json matches struct fields case-insensitively. The wire protocol
+// does not: aliases must not overwrite an independently pinned field.
+func exactFields(raw json.RawMessage, kind reflect.Type) error {
+	if kind == reflect.TypeOf(time.Time{}) {
+		return nil
+	}
+	switch kind.Kind() {
+	case reflect.Struct:
+		var fields map[string]json.RawMessage
+		if err := json.Unmarshal(raw, &fields); err != nil {
+			return err
+		}
+		allowed := map[string]reflect.Type{}
+		for i := 0; i < kind.NumField(); i++ {
+			field := kind.Field(i)
+			allowed[field.Tag.Get("json")] = field.Type
+		}
+		for name, value := range fields {
+			nested, ok := allowed[name]
+			if !ok {
+				return fmt.Errorf("exact native JSON field name required")
+			}
+			if err := exactFields(value, nested); err != nil {
+				return err
+			}
+		}
+	case reflect.Slice:
+		var values []json.RawMessage
+		if err := json.Unmarshal(raw, &values); err != nil {
+			return err
+		}
+		for _, value := range values {
+			if err := exactFields(value, kind.Elem()); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
+
+func uniqueValue(d *json.Decoder, depth int) error {
+	if depth > 16 {
+		return fmt.Errorf("bounded native JSON depth required")
+	}
+	token, err := d.Token()
+	if err != nil {
+		return err
+	}
+	delim, ok := token.(json.Delim)
+	if !ok {
+		return nil
+	}
+	switch delim {
+	case '{':
+		seen := map[string]bool{}
+		for d.More() {
+			key, err := d.Token()
+			if err != nil {
+				return err
+			}
+			s, ok := key.(string)
+			if !ok || seen[s] {
+				return fmt.Errorf("duplicate native JSON key")
+			}
+			seen[s] = true
+			if err := uniqueValue(d, depth+1); err != nil {
+				return err
+			}
+		}
+	case '[':
+		for d.More() {
+			if err := uniqueValue(d, depth+1); err != nil {
+				return err
+			}
+		}
+	default:
+		return fmt.Errorf("invalid native JSON delimiter")
+	}
+	_, err = d.Token()
+	return err
+}
+
+func parseBudget(raw string, opts options) (*budgetDocument, error) {
+	var b budgetDocument
+	if err := decode(raw, &b); err != nil {
+		return nil, err
+	}
+	if b.Protocol != "cps-native-pool-budget/v1" || b.Version != 1 || !b.Catalog.valid() || b.Catalog.Key != "catalog.json" || !digestPattern.MatchString(b.PolicyHash) || len(b.Nodes) < 1 || len(b.Nodes) > 64 {
+		return nil, fmt.Errorf("closed Root qualified budget projection required")
+	}
+	nodes, physical, qualificationNS, claimRefs := map[string]bool{}, map[string]bool{}, map[string]bool{}, map[objectRef]bool{}
+	for _, n := range b.Nodes {
+		if !validName(n.Name) || !validUID(n.UID) || !validUID(n.BootID) || !validUID(n.DriverGeneration) || nodes[n.Name] || !n.ClaimsRef.valid() || n.ClaimsRef.Namespace != opts.claimsNS || claimRefs[n.ClaimsRef] || len(n.Devices) < 1 || len(n.Devices) > 64 {
+			return nil, fmt.Errorf("unique complete qualified Node budget required")
+		}
+		nodes[n.Name] = true
+		claimRefs[n.ClaimsRef] = true
+		runtimeIDs := map[string]bool{}
+		for _, device := range n.Devices {
+			if len(device.UUID) < 4 || device.UUID[:4] != "GPU-" || !validUID(device.UUID[4:]) || physical[device.UUID] || !runtimePattern.MatchString(device.RuntimeID) || runtimeIDs[device.RuntimeID] || device.MemoryMiB < 1 || device.MemoryMiB > 1<<30 || device.BudgetMiB < 1 || device.BudgetMiB > device.MemoryMiB || device.MaxWorkspaces < 1 || device.MaxWorkspaces > maxRecords || len(device.Profiles) < 1 || len(device.Profiles) > 64 || !device.Qualification.valid() || qualificationNS[device.Qualification.Namespace] {
+				return nil, fmt.Errorf("unique measured device budget/count/profile required")
+			}
+			physical[device.UUID] = true
+			runtimeIDs[device.RuntimeID] = true
+			qualificationNS[device.Qualification.Namespace] = true
+			for profile, capMiB := range device.Profiles {
+				if !validNamespace(profile) || capMiB < 1 || capMiB > device.BudgetMiB {
+					return nil, fmt.Errorf("measured profile cap required")
+				}
+			}
+		}
+	}
+	return &b, nil
+}
+
+func parseClaims(raw string, b nodeBudget, projection immutableRef) (*claimsDocument, error) {
+	var c claimsDocument
+	if err := decode(raw, &c); err != nil {
+		return nil, err
+	}
+	if c.Protocol != "cps-native-pool-claims/v1" || c.Version != 1 || c.Projection != projection || c.Node != b.Name || c.NodeUID != b.UID || c.BootID != b.BootID || c.DriverGeneration != b.DriverGeneration || c.Claims == nil || len(c.Claims) > maxRecords || c.Issued.IsZero() || !c.Expires.After(c.Issued) {
+		return nil, fmt.Errorf("closed current Node claims snapshot required")
+	}
+	devices := map[string]bool{}
+	for _, device := range b.Devices {
+		devices[device.UUID] = true
+	}
+	for _, entry := range c.Claims {
+		if !validUID(entry.Attempt) || !entry.Pod.valid() || !devices[entry.UUID] || entry.CapMiB < 1 || entry.CapMiB > 1<<30 || (entry.State != "active" && entry.State != "retiring") {
+			return nil, fmt.Errorf("retained active/retiring claim required")
+		}
+	}
+	return &c, nil
+}
+
+func parseRequest(raw string, b *budgetDocument) (*requestDocument, error) {
+	var r requestDocument
+	if err := decode(raw, &r); err != nil {
+		return nil, err
+	}
+	if r.Protocol != "cps-native-pool-request/v1" || r.Version != 1 || !r.Pod.valid() || !validUID(r.Attempt) || !validNamespace(r.Profile) || r.CapMiB < 1 || r.CapMiB > 1<<30 || !bareDigestPattern.MatchString(r.PendingHash) || r.PolicyHash != b.PolicyHash || r.Catalog != b.Catalog || !r.Source.valid() || r.Source.Key != "source.json" || !digestPattern.MatchString(r.HeadRevision) || r.Deadline.IsZero() {
+		return nil, fmt.Errorf("closed trusted Gateway request required")
+	}
+	return &r, nil
+}
