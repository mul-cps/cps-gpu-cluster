+			annotations := admitted["metadata"].(map[string]interface{})["annotations"].(map[string]interface{})
+			switch fault {
+			case "unknown-profile":
+				reg["profile"] = "arbitrary"
+			case "profile-mismatch":
+				reg["profile"] = "interactive-shared-10"
+			case "memory":
+				annotations["gpu-memory"] = "5324"
+			case "container-memory":
+				annotations["nvidia.com/container.notebook.gpu-memory.request"] = "5324Mi"
+			case "container-name":
+				annotations["gpu-fraction-container-name"] = "other"
+			case "source-name":
+				document["source_pod"].(map[string]interface{})["metadata"].(map[string]interface{})["name"] = "other"
+			case "seed-attempt":
+				document["attempt"] = "11111111-2222-4333-8444-555555555500"
+			case "live-only":
+				delete(annotations, "gpu-memory")
+				pod.Annotations["gpu-memory"] = "5120"
+			}
+			raw, _ := json.Marshal(reg)
+			registry.Data["registry.json"] = string(raw)
+			raw, _ = json.Marshal(document)
+			seed.Data["seed.json"] = string(raw)
+			kube := nativeTestClient(t, pod, node, br, func(*v1.Binding) error { t.Fatal("unexpected Bind"); return nil }, registry, seed)
+			reservation := &nativeCountingReservation{}
+			binder := NewBinder(kube, reservation, plugins.New())
+			binder.SetNativeTerminal(kube, "authority", &nativeTestCoordinator{})
+			err := binder.Bind(context.Background(), pod, node, br)
+			cms := &v1.ConfigMapList{}
+			_ = kube.List(context.Background(), cms, client.InNamespace(pod.Namespace))
+			if !errors.Is(err, ErrNativeCustodyHeld) || reservation.syncs != 0 || len(cms.Items) != 0 {
+				t.Fatalf("untrusted cap reached side effects: %v sync%d maps%d", err, reservation.syncs, len(cms.Items))
+			}
+		})
+	}
+}
+
+func TestLegacyNativeRegistryKeepsStockMemoryScalar(t *testing.T) {
+	pod, node, br := nativeTestInputs()
+	kube := nativeTestClient(t, pod, node, br, func(*v1.Binding) error { return nil })
+	registry := &v1.ConfigMap{}
+	if err := kube.Get(context.Background(), client.ObjectKey{Namespace: "authority", Name: "cps-pending-registry-" + string(pod.UID)}, registry); err != nil {
+		t.Fatal(err)
+	}
+	var document map[string]interface{}
+	_ = json.Unmarshal([]byte(registry.Data["registry.json"]), &document)
+	document["profile"] = "interactive-native-qualification-10"
+	raw, _ := json.Marshal(document)
+	registry.Data["registry.json"] = string(raw)
+	if err := kube.Update(context.Background(), registry); err != nil {
+		t.Fatal(err)
+	}
+	binder := NewBinder(kube, &nativeTestReservation{}, plugins.New())
+	binder.SetNativeTerminal(kube, "authority", &nativeTestCoordinator{})
+	var cap int64
+	if err := binder.nativeRegistryProof(context.Background(), pod, &cap); err != nil || cap != 0 {
+		t.Fatalf("legacy route changed: cap%d error%v", cap, err)
+	}
+}
+
+// The optional combined bridge must consume the fresh snapshot and actual ACK
+// before the one Kubernetes Binding, and never fall back after a denial.
+type nativeAtomicTestCoordinator struct {
+	*nativeTestCoordinator
+	atomic func(context.Context, NativeTerminalSnapshot, *v1.ConfigMap, *unstructured.Unstructured) error
+}
+type nativeAtomicTestFence struct {
+	NativeAllocationFence
+	owner *nativeAtomicTestCoordinator
+}
+
+func (c *nativeAtomicTestCoordinator) Prepare(ctx context.Context, s NativeTerminalSnapshot) (NativeAllocationFence, error) {
+	f, err := c.nativeTestCoordinator.Prepare(ctx, s)
+	return &nativeAtomicTestFence{NativeAllocationFence: f, owner: c}, err
+}
+func (f *nativeAtomicTestFence) ValidateCurrentAndBinding(ctx context.Context, s NativeTerminalSnapshot, a *v1.ConfigMap, b *unstructured.Unstructured) error {
+	f.owner.calls = append(f.owner.calls, "atomic-current-binding")
+	return f.owner.atomic(ctx, s, a, b)
+}
+func TestNativeAtomicCurrentBindingRetainsFreshInputsAndFailureCustody(t *testing.T) {
+	for _, outcome := range []string{"success", "denied", "cancelled"} {
+		t.Run(outcome, func(t *testing.T) {
+			pod, node, br := nativeTestInputs()
+			for k, v := range nativeTestState().BindingPodAnnotations {
+				pod.Annotations[k] = v
+			}
+			ack := nativeTestACK(pod)
+			coord := &nativeAtomicTestCoordinator{nativeTestCoordinator: &nativeTestCoordinator{ack: ack}}
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			coord.atomic = func(_ context.Context, s NativeTerminalSnapshot, a *v1.ConfigMap, b *unstructured.Unstructured) error {
+				if !reflect.DeepEqual(a, ack) || s.Pod.UID != pod.UID || s.Node.UID != node.UID || s.BindRequest.UID != br.UID || !reflect.DeepEqual(s.BindingState, nativeTestState()) {
+					t.Fatal("combined validation lost actual readback")
+				}
+				if b.Object["metadata"].(map[string]interface{})["resourceVersion"] != s.Pod.ResourceVersion {
+					t.Fatal("Binding not pinned to fresh Pod")
+				}
+				if outcome == "denied" {
+					return errors.New("authority changed")
+				}
+				if outcome == "cancelled" {
+					cancel()
+				}
+				return nil
+			}
+			bindings := 0
+			kube := nativeTestClient(t, pod, node, br, func(*v1.Binding) error { bindings++; coord.calls = append(coord.calls, "binding"); return nil }, ack)
+			binder := NewBinder(kube, &nativeTestReservation{}, plugins.New())
+			binder.SetNativeTerminal(kube, "authority", coord)
+			err := binder.bindNativeTerminal(ctx, pod, node, br, nativeTestState())
+			expected := []string{"prepare", "atomic-current-binding", "binding", "bound", "close"}
+			if outcome != "success" {
+				expected = []string{"prepare", "atomic-current-binding", "hold", "close"}
+				if err == nil || bindings != 0 {
+					t.Fatal("failed combined proof reached Binding")
+				}
+			} else if err != nil || bindings != 1 {
+				t.Fatalf("normal Binding failed: %v", err)
+			}
+			if !reflect.DeepEqual(coord.calls, expected) {
+				t.Fatalf("wrong combined order %v; expected %v", coord.calls, expected)
+			}
+		})
+	}
+}
diff --git a/pkg/binder/binding/native_transport.go b/pkg/binder/binding/native_transport.go
new file mode 100644
index 0000000..31c8cf9
--- /dev/null
+++ b/pkg/binder/binding/native_transport.go
@@ -0,0 +1,324 @@
+// SPDX-License-Identifier: Apache-2.0
+package binding
+
+import (
+	"bytes"
+	"context"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"mime"
+	"net/http"
+	"net/url"
+	"os"
+	"regexp"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/google/uuid"
+	v1 "k8s.io/api/core/v1"
+	"k8s.io/apimachinery/pkg/apis/meta/v1/unstructured"
+	"k8s.io/apimachinery/pkg/types"
+	"sigs.k8s.io/controller-runtime/pkg/log"
+)
+
+const nativeWireProtocol = "cps-native-kai-terminal/v1"
+const nativeHTTPMaxBytes = 1024 * 1024
+
+type NativeHTTPConfig struct {
+	Enabled                                    bool
+	URL, AuthorityNamespace, TokenFile, CAFile string
+}
+type NativeHTTP struct {
+	origin, tokenFile string
+	client            *http.Client
+}
+
+func NewNativeHTTP(config NativeHTTPConfig) (*NativeHTTP, error) {
+	if !config.Enabled {
+		return nil, nil
+	}
+	origin, err := url.Parse(config.URL)
+	if err != nil || origin.Scheme != "https" || origin.Host == "" || origin.User != nil || strings.Trim(origin.Path, "/") != "" || origin.RawQuery != "" || origin.Fragment != "" || config.TokenFile == "" || config.CAFile == "" || !regexp.MustCompile(`^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$`).MatchString(config.AuthorityNamespace) {
+		return nil, errors.New("explicit HTTPS coordinator origin and private identity configuration required")
+	}
+	ca, err := nativeReadFile(config.CAFile, nativeHTTPMaxBytes)
+	if err != nil {
+		return nil, errors.New("trusted coordinator CA unavailable")
+	}
+	pool := x509.NewCertPool()
+	if !pool.AppendCertsFromPEM(ca) {
+		return nil, errors.New("trusted coordinator CA invalid")
+	}
+	transport := &http.Transport{TLSClientConfig: &tls.Config{RootCAs: pool, MinVersion: tls.VersionTLS12}, MaxConnsPerHost: 4}
+	return &NativeHTTP{origin: "https://" + origin.Host, tokenFile: config.TokenFile, client: &http.Client{Transport: transport, Timeout: 15 * time.Second, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}}, nil
+}
+
+func nativeReadFile(path string, maximum int64) ([]byte, error) {
+	file, err := os.Open(path)
+	if err != nil {
+		return nil, err
+	}
+	defer file.Close()
+	info, err := file.Stat()
+	if err != nil || !info.Mode().IsRegular() || info.Mode().Perm()&0o022 != 0 {
+		return nil, errors.New("read-only regular internal identity file required")
+	}
+	value, err := io.ReadAll(io.LimitReader(file, maximum+1))
+	if err != nil || int64(len(value)) > maximum {
+		return nil, errors.New("internal identity file size exceeded")
+	}
+	return value, nil
+}
+
+func nativeJSONValue(decoder *json.Decoder) (interface{}, error) {
+	token, err := decoder.Token()
+	if err != nil {
+		return nil, err
+	}
+	if delimiter, ok := token.(json.Delim); ok {
+		switch delimiter {
+		case '{':
+			object := map[string]interface{}{}
+			for decoder.More() {
+				keyToken, err := decoder.Token()
+				if err != nil {
+					return nil, err
+				}
+				key, ok := keyToken.(string)
+				if !ok {
+					return nil, errors.New("JSON object key required")
+				}
+				if _, duplicate := object[key]; duplicate {
+					return nil, errors.New("duplicate JSON field")
+				}
+				value, err := nativeJSONValue(decoder)
+				if err != nil {
+					return nil, err
+				}
+				object[key] = value
+			}
+			_, err = decoder.Token()
+			return object, err
+		case '[':
+			array := []interface{}{}
+			for decoder.More() {
+				value, err := nativeJSONValue(decoder)
+				if err != nil {
+					return nil, err
+				}
+				array = append(array, value)
+			}
+			_, err = decoder.Token()
+			return array, err
+		default:
+			return nil, errors.New("unexpected JSON delimiter")
+		}
+	}
+	return token, nil
+}
+
+func (bridge *NativeHTTP) call(ctx context.Context, operation string, fields map[string]interface{}, responseFields ...string) (map[string]interface{}, error) {
+	id := uuid.NewString()
+	body := map[string]interface{}{"protocol": nativeWireProtocol, "operation": operation, "request_id": id}
+	for key, value := range fields {
+		if _, reserved := body[key]; reserved {
+			return nil, errors.New("reserved transport field")
+		}
+		body[key] = value
+	}
+	encoded, err := json.Marshal(body)
+	if err != nil || len(encoded) > nativeHTTPMaxBytes {
+		return nil, errors.New("closed coordinator request unavailable")
+	}
+	tokenBytes, err := nativeReadFile(bridge.tokenFile, 64*1024)
+	if err != nil {
+		return nil, errors.New("signed internal service token unavailable")
+	}
+	token := strings.TrimSpace(string(tokenBytes))
+	if !regexp.MustCompile(`^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$`).MatchString(token) {
+		return nil, errors.New("signed projected internal service token required")
+	}
+	request, err := http.NewRequestWithContext(ctx, http.MethodPost, bridge.origin+"/api/native-kai/v1/"+operation, bytes.NewReader(encoded))
+	if err != nil {
+		return nil, errors.New("coordinator request invalid")
+	}
+	request.Header.Set("Authorization", "Bearer "+token)
+	request.Header.Set("Content-Type", "application/json")
+	client := bridge.client
+	if operation == "prepare" || operation == "accepted" {
+		// Accepted may wait for readiness under the existing server fence.
+		// A client copy preserves other operations and earlier cancellation.
+		bounded := *client
+		bounded.Timeout = 130 * time.Second
+		if operation == "accepted" {
+			bounded.Timeout = 60 * time.Second
+		}
+		client = &bounded
+	}
+	response, err := client.Do(request)
+	if err != nil {
+		return nil, fmt.Errorf("coordinator %s transport failed", operation)
+	}
+	defer response.Body.Close()
+	refresh := operation == "prepare" && response.StatusCode == http.StatusConflict
+	if response.StatusCode != http.StatusOK && !refresh {
+		return nil, fmt.Errorf("coordinator %s HTTP %d", operation, response.StatusCode)
+	}
+	media, _, err := mime.ParseMediaType(response.Header.Get("Content-Type"))
+	if err != nil || media != "application/json" {
+		return nil, errors.New("coordinator JSON response required")
+	}
+	raw, err := io.ReadAll(io.LimitReader(response.Body, nativeHTTPMaxBytes+1))
+	if err != nil || len(raw) > nativeHTTPMaxBytes {
+		return nil, errors.New("coordinator response size exceeded")
+	}
+	decoder := json.NewDecoder(bytes.NewReader(raw))
+	decoder.UseNumber()
+	value, err := nativeJSONValue(decoder)
+	if err != nil {
+		return nil, errors.New("coordinator response JSON invalid")
+	}
+	if _, err = decoder.Token(); err != io.EOF {
+		return nil, errors.New("trailing coordinator JSON")
+	}
+	object, ok := value.(map[string]interface{})
+	if refresh {
+		retry, retryOK := object["retry"].(map[string]interface{})
+		pod, podOK := fields["pod"].(map[string]interface{})
+		podUID, podUIDOK := pod["uid"].(string)
+		retryUID, retryUIDOK := retry["pod_uid"].(string)
+		parsedUID, uidErr := uuid.Parse(podUID)
+		if !ok || len(object) != 4 || object["protocol"] != nativeWireProtocol || object["operation"] != operation || object["request_id"] != id || !retryOK || len(retry) != 3 || retry["version"] != json.Number("1") || retry["code"] != "registered-snapshot-refresh" || !podOK || !podUIDOK || !retryUIDOK || uidErr != nil || parsedUID.String() != podUID || retryUID != podUID {
+			return nil, errors.New("coordinator refresh envelope differs")
+		}
+		return nil, errors.Join(ErrNativeCustodyHeld, ErrNativePrepareSnapshotRefresh)
+	}
+	if !ok || len(object) != 3+len(responseFields) || object["protocol"] != nativeWireProtocol || object["operation"] != operation || object["request_id"] != id {
+		return nil, errors.New("coordinator response envelope differs")
+	}
+	allowed := map[string]bool{"protocol": true, "operation": true, "request_id": true}
+	for _, field := range responseFields {
+		allowed[field] = true
+	}
+	for field := range object {
+		if !allowed[field] {
+			return nil, errors.New("unknown coordinator response field")
+		}
+	}
+	return object, nil
+}
+
+func nativeObjectRef(name, namespace string, uid types.UID, version string) map[string]interface{} {
+	ref := map[string]interface{}{"name": name, "uid": string(uid), "resourceVersion": version}
+	if namespace != "" {
+		ref["namespace"] = namespace
+	}
+	return ref
+}
+func nativeSnapshotFields(snapshot NativeTerminalSnapshot) map[string]interface{} {
+	request := nativeObjectRef(snapshot.BindRequest.Name, snapshot.BindRequest.Namespace, snapshot.BindRequest.UID, snapshot.BindRequest.ResourceVersion)
+	request["generation"] = snapshot.BindRequest.Generation
+	return map[string]interface{}{"pod": nativeObjectRef(snapshot.Pod.Name, snapshot.Pod.Namespace, snapshot.Pod.UID, snapshot.Pod.ResourceVersion), "node": nativeObjectRef(snapshot.Node.Name, "", snapshot.Node.UID, snapshot.Node.ResourceVersion), "bind_request": request, "binding_state": map[string]interface{}{"binding_pod_annotations": snapshot.BindingState.BindingPodAnnotations, "reserved_gpu_ids": snapshot.BindingState.ReservedGPUIds}}
+}
+func nativeDecodeObject(value interface{}, output interface{}) error {
+	encoded, err := json.Marshal(value)
+	if err != nil {
+		return err
+	}
+	return json.Unmarshal(encoded, output)
+}
+
+func (bridge *NativeHTTP) Prepare(ctx context.Context, snapshot NativeTerminalSnapshot) (NativeAllocationFence, error) {
+	response, err := bridge.call(ctx, "prepare", nativeSnapshotFields(snapshot), "fence_id", "ack")
+	if err != nil {
+		return nil, err
+	}
+	fenceID, ok := response["fence_id"].(string)
+	parsed, parseErr := uuid.Parse(fenceID)
+	if !ok || parseErr != nil || parsed.String() != fenceID {
+		return nil, errors.New("canonical server execution fence required")
+	}
+	ack := &v1.ConfigMap{}
+	if err = nativeDecodeObject(response["ack"], ack); err != nil {
+		return nil, errors.New("actual ACK API object required")
+	}
+	return &nativeHTTPFence{bridge: bridge, id: fenceID, ack: ack}, nil
+}
+func (bridge *NativeHTTP) Hold(ctx context.Context, uid types.UID, _ error) error {
+	_, err := bridge.call(ctx, "hold", map[string]interface{}{"pod_uid": string(uid), "reason_code": "custody-required"})
+	return err
+}
+func (bridge *NativeHTTP) CleanupMaps(ctx context.Context, uid types.UID) ([]v1.ConfigMap, error) {
+	response, err := bridge.call(ctx, "cleanup-maps", map[string]interface{}{"pod_uid": string(uid)}, "maps")
+	if err != nil {
+		return nil, err
+	}
+	if _, ok := response["maps"].([]interface{}); !ok {
+		return nil, errors.New("cleanup evidence must be an actual JSON array")
+	}
+	maps := []v1.ConfigMap{}
+	if err = nativeDecodeObject(response["maps"], &maps); err != nil {
+		return nil, errors.New("actual cleanup map snapshots required")
+	}
+	return maps, nil
+}
+func (bridge *NativeHTTP) MayDeleteReservation(ctx context.Context, pod *v1.Pod) (bool, error) {
+	response, err := bridge.call(ctx, "reservation-delete", map[string]interface{}{"reservation": nativeObjectRef(pod.Name, pod.Namespace, pod.UID, pod.ResourceVersion)}, "may_delete")
+	if err != nil {
+		return false, err
+	}
+	allowed, ok := response["may_delete"].(bool)
+	if !ok {
+		return false, errors.New("typed reservation deletion decision required")
+	}
+	return allowed, nil
+}
+
+type nativeHTTPFence struct {
+	bridge *NativeHTTP
+	id     string
+	ack    *v1.ConfigMap
+	once   sync.Once
+}
+
+func (fence *nativeHTTPFence) ACK() *v1.ConfigMap { return fence.ack.DeepCopy() }
+func (fence *nativeHTTPFence) ValidateCurrent(ctx context.Context, snapshot NativeTerminalSnapshot, ack *v1.ConfigMap) error {
+	fields := nativeSnapshotFields(snapshot)
+	fields["fence_id"] = fence.id
+	fields["ack"] = nativeObjectRef(ack.Name, ack.Namespace, ack.UID, ack.ResourceVersion)
+	_, err := fence.bridge.call(ctx, "current", fields)
+	return err
+}
+
+// ValidateCurrentAndBinding retains the exact fresh Current payload while
+// combining its server validation with the subsequent Binding custody CAS.
+func (fence *nativeHTTPFence) ValidateCurrentAndBinding(ctx context.Context, snapshot NativeTerminalSnapshot, ack *v1.ConfigMap, binding *unstructured.Unstructured) error {
+	fields := nativeSnapshotFields(snapshot)
+	fields["fence_id"] = fence.id
+	fields["ack"] = nativeObjectRef(ack.Name, ack.Namespace, ack.UID, ack.ResourceVersion)
+	fields["binding"] = binding.Object
+	_, err := fence.bridge.call(ctx, "current-binding", fields)
+	return err
+}
+func (fence *nativeHTTPFence) ValidateBinding(ctx context.Context, binding *unstructured.Unstructured) error {
+	_, err := fence.bridge.call(ctx, "binding", map[string]interface{}{"fence_id": fence.id, "binding": binding.Object})
+	return err
+}
+func (fence *nativeHTTPFence) BindingAccepted(ctx context.Context, binding *unstructured.Unstructured) error {
+	_, err := fence.bridge.call(ctx, "accepted", map[string]interface{}{"fence_id": fence.id, "binding": binding.Object})
+	return err
+}
+func (fence *nativeHTTPFence) Close() {
+	fence.once.Do(func() {
+		ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+		defer cancel()
+		if _, err := fence.bridge.call(ctx, "close", map[string]interface{}{"fence_id": fence.id}); err != nil {
+			log.FromContext(ctx).Error(err, "Native execution fence close unresolved; server custody must remain held")
+		}
+	})
+}
