+func (f *testFixture) open(t *testing.T) *plugin {
+	t.Helper()
+	f.budget.Data = map[string]string{"budget.json": encode(f.budgetBody)}
+	ref := map[string]any{"namespace": f.budget.Namespace, "name": f.budget.Name, "uid": string(f.budget.UID), "resourceVersion": f.budget.ResourceVersion, "data_sha256": hash(f.budget.Data), "key": "budget.json"}
+	f.args["budgetReference"] = encode(ref)
+	f.claimsBody["projection_ref"] = ref
+	f.claims.Data = map[string]string{"claims.json": encode(f.claimsBody)}
+	objects := []runtime.Object{f.budget, f.claims, f.node.Node}
+	for _, cm := range f.requests {
+		objects = append(objects, cm)
+	}
+	for _, p := range f.reservationPods {
+		objects = append(objects, p)
+	}
+	for _, task := range f.tasks {
+		objects = append(objects, task.Pod)
+	}
+	f.client = fake.NewClientset(objects...)
+	factory := informers.NewSharedInformerFactory(f.client, 0)
+	factory.Core().V1().ConfigMaps().Informer()
+	factory.Core().V1().Nodes().Informer()
+	factory.Core().V1().Pods().Informer()
+	stop := make(chan struct{})
+	t.Cleanup(func() { close(stop) })
+	factory.Start(stop)
+	require.True(t, clientcache.WaitForCacheSync(stop, factory.Core().V1().ConfigMaps().Informer().HasSynced, factory.Core().V1().Nodes().Informer().HasSynced, factory.Core().V1().Pods().Informer().HasSynced))
+	cache := scheduler_cache.NewMockCache(gomock.NewController(t))
+	cache.EXPECT().KubeInformerFactory().Return(factory).AnyTimes()
+	f.ssn.Cache = cache
+	p := New(f.args).(*plugin)
+	p.now = func() time.Time { return f.now }
+	p.OnSessionOpen(f.ssn)
+	t.Cleanup(func() { p.OnSessionClose(f.ssn) })
+	return p
+}
