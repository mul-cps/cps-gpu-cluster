+// Copyright 2026 NVIDIA CORPORATION
+// SPDX-License-Identifier: Apache-2.0
+
+package nativequalifiedbudget
+
+import (
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestNativeJSONRejectsCaseAliasesUnknownFieldsDuplicatesAndTrailingDocuments(t *testing.T) {
+	for _, raw := range []string{
+		`{"namespace":"root","name":"budget","uid":"00000001-1111-4111-8111-000000000001","resourceVersion":"1","data_sha256":"sha256:` + strings.Repeat("1", 64) + `","key":"budget.json","Namespace":"foreign"}`,
+		`{"Namespace":"root"}`,
+		`{"unknown":"value"}`,
+		`{"namespace":"root","namespace":"foreign"}`,
+		`{} {}`,
+	} {
+		var ref immutableRef
+		require.Error(t, decode(raw, &ref), raw)
+	}
+}
+
+func TestVersionedGoldenContractsAndIndependentCanonicalHashes(t *testing.T) {
+	read := func(name string) string {
+		raw, err := os.ReadFile("testdata/" + name)
+		require.NoError(t, err)
+		return string(raw)
+	}
+	var ref immutableRef
+	require.NoError(t, decode(read("budget-reference.json"), &ref))
+	require.True(t, ref.valid())
+	raw := read("budget.json")
+	require.Equal(t, ref.DataSHA, canonicalHash(map[string]string{"budget.json": raw}))
+	budget, err := parseBudget(raw, options{claimsNS: "node-claims"})
+	require.NoError(t, err)
+	claims, err := parseClaims(read("claims.json"), budget.Nodes[0], ref)
+	require.NoError(t, err)
+	request, err := parseRequest(read("request.json"), budget)
+	require.NoError(t, err)
+	require.Equal(t, claims.Claims[0].Pod, request.Pod)
+	var expected map[string]string
+	require.NoError(t, decode(read("expected-hashes.json"), &expected))
+	require.Equal(t, expected["projection_ref_sha256"], ref.canonicalHash())
+	require.Equal(t, expected["catalog_ref_sha256"], budget.Catalog.canonicalHash())
+	require.Equal(t, expected["profile_sha256"], canonicalHash(request.Profile))
+}
diff --git a/pkg/scheduler/plugins/nativequalifiedbudget/nativequalifiedbudget.go b/pkg/scheduler/plugins/nativequalifiedbudget/nativequalifiedbudget.go
new file mode 100644
index 0000000..c2041a8
--- /dev/null
+++ b/pkg/scheduler/plugins/nativequalifiedbudget/nativequalifiedbudget.go
@@ -0,0 +1,134 @@
+// Copyright 2026 NVIDIA CORPORATION
+// SPDX-License-Identifier: Apache-2.0
+
+package nativequalifiedbudget
+
+import (
+	"fmt"
+	"strconv"
+	"sync"
+	"time"
+
+	v1 "k8s.io/api/core/v1"
+
+	"github.com/kai-scheduler/KAI-scheduler/pkg/scheduler/api/node_info"
+	"github.com/kai-scheduler/KAI-scheduler/pkg/scheduler/api/pod_info"
+	"github.com/kai-scheduler/KAI-scheduler/pkg/scheduler/framework"
+)
+
+type plugin struct {
+	opts     options
+	err      error
+	provider *provider
+	now      func() time.Time
+	mu       sync.Mutex
+	usage    map[string]cachedAccounting
+}
+
+// New constructs the explicit opt-in candidate filter; it starts no watches or I/O.
+func New(arguments framework.PluginArguments) framework.Plugin {
+	opts, err := parseOptions(arguments)
+	return &plugin{opts: opts, err: err, now: time.Now, usage: map[string]cachedAccounting{}}
+}
+func (p *plugin) Name() string { return Name }
+
+func (p *plugin) OnSessionOpen(ssn *framework.Session) {
+	if p.opts.enabled && p.err == nil {
+		p.provider = newProvider(ssn, p.opts, p.now())
+	}
+	ssn.AddGPUOrderFn(p.gpuOrder)
+	ssn.AddEventHandler(&framework.EventHandler{AllocateFunc: p.changedAllocation, DeallocateFunc: p.changedAllocation})
+}
+func (p *plugin) OnSessionClose(_ *framework.Session) {
+	if p.provider != nil {
+		p.provider.close()
+	}
+	p.mu.Lock()
+	p.usage = map[string]cachedAccounting{}
+	p.mu.Unlock()
+}
+func (p *plugin) changedAllocation(event *framework.Event) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if event == nil || event.Task == nil {
+		p.usage = map[string]cachedAccounting{}
+		return
+	}
+	delete(p.usage, event.Task.NodeName)
+}
+
+func qualifiedNode(node *node_info.NodeInfo, view *nodeView, request requestDocument, profileLabel, catalogLabelValue string) bool {
+	if node == nil || node.Node == nil || node.Name != view.budget.Name || nodeVersion(node.Node) != view.nodeRef || string(node.Node.UID) != view.budget.UID || node.Node.DeletionTimestamp != nil || node.Node.Spec.Unschedulable || node.Node.Status.NodeInfo.BootID != view.budget.BootID || node.HasDRAGPUs {
+		return false
+	}
+	if strategy := node.Node.Labels["nvidia.com/mig.strategy"]; strategy != "" && strategy != "none" {
+		return false
+	}
+	ready := 0
+	for _, condition := range node.Node.Status.Conditions {
+		if condition.Type == v1.NodeReady {
+			if condition.Status != v1.ConditionTrue {
+				return false
+			}
+			ready++
+		}
+	}
+	if ready != 1 {
+		return false
+	}
+	quantity, ok := node.Node.Status.Allocatable["nvidia.com/gpu"]
+	if !ok {
+		return false
+	}
+	count, integer := quantity.AsInt64()
+	if !integer || count != int64(len(view.budget.Devices)) {
+		return false
+	}
+	if node.Node.Labels["kubernetes.io/hostname"] != node.Name || node.Node.Labels[profileLabel] != catalogLabelValue {
+		return false
+	}
+	for _, device := range view.budget.Devices {
+		if device.Profiles[request.Profile] != request.CapMiB || node.Node.Labels["nvidia.com/gpu.memory"] != strconv.FormatInt(device.MemoryMiB, 10) {
+			return false
+		}
+	}
+	return true
+}
+
+func (p *plugin) gpuOrder(task *pod_info.PodInfo, node *node_info.NodeInfo, group string) (float64, error) {
+	if task == nil || task.Pod == nil || task.Pod.Annotations[marker] == "" {
+		return 0, nil
+	}
+	denied := fmt.Errorf("native qualified GPU candidate unavailable")
+	if task.Pod.Annotations[marker] != "v2" || !p.opts.enabled || p.err != nil || p.provider == nil || p.provider.err != nil {
+		return 0, denied
+	}
+	request, ok := p.provider.requests[string(task.UID)]
+	if !ok || !matchesTask(request.body, task) || node == nil {
+		return 0, denied
+	}
+	view := p.provider.views[node.Name]
+	if !p.provider.current(view, request, task.Pod, p.now()) || !qualifiedNode(node, view, *request.body, request.profileLabel, p.provider.catalogLabelValue) {
+		return 0, denied
+	}
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	current, ok := p.usage[node.Name]
+	if !ok || current.podUID != string(task.UID) {
+		current.state, current.err = buildAccounting(p.provider, view, node, task)
+		current.podUID = string(task.UID)
+		p.usage[node.Name] = current
+	}
+	if current.err != nil {
+		return 0, denied
+	}
+	for _, ref := range current.state.reservations {
+		if !p.provider.reservationCurrent(ref.ref, ref.group) {
+			return 0, denied
+		}
+	}
+	if !current.state.fits(view, task, *request.body, group) {
+		return 0, denied
+	}
+	return 0, nil
+}
