+
+func TestNativeHTTPDisabledDoesNotReadCredentials(t *testing.T) {
+	bridge, err := NewNativeHTTP(NativeHTTPConfig{Enabled: false, URL: "invalid", TokenFile: "/not-read", CAFile: "/not-read"})
+	if err != nil || bridge != nil {
+		t.Fatalf("disabled bridge activated: %v", err)
+	}
+}
+
+func nativeTransportFixture(t *testing.T, handler http.HandlerFunc) (*NativeHTTP, string) {
+	t.Helper()
+	server := httptest.NewTLSServer(handler)
+	t.Cleanup(server.Close)
+	directory := t.TempDir()
+	token := filepath.Join(directory, "projected-token")
+	ca := filepath.Join(directory, "ca.crt")
+	if err := os.WriteFile(token, []byte("unit.header.signature"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(ca, pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: server.Certificate().Raw}), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	bridge, err := NewNativeHTTP(NativeHTTPConfig{Enabled: true, URL: server.URL, AuthorityNamespace: "authority", TokenFile: token, CAFile: ca})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return bridge, token
+}
+
+func TestNativeHTTPClosedWireFlowAndTokenRotation(t *testing.T) {
+	pod, node, br := nativeTestInputs()
+	pod.Annotations["received-resource-type"] = "Fraction"
+	ack := nativeTestACK(pod)
+	operations := []string{}
+	bridge, token := nativeTransportFixture(t, func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != "POST" || !strings.HasPrefix(r.URL.Path, "/api/native-kai/v1/") {
+			t.Errorf("unexpected route %s %s", r.Method, r.URL.Path)
+		}
+		var body map[string]interface{}
+		if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+			t.Error(err)
+		}
+		op := strings.TrimPrefix(r.URL.Path, "/api/native-kai/v1/")
+		operations = append(operations, op)
+		if body["protocol"] != "cps-native-kai-terminal/v1" || body["operation"] != op || body["request_id"] == "" {
+			t.Error("closed envelope missing identity")
+		}
+		expectedToken := "unit.header.signature"
+		if len(operations) > 1 {
