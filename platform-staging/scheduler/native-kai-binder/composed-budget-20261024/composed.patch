+type nativeDeadlineTransport struct {
+	t         *testing.T
+	operation string
+	calls     int
+}
+
+func (transport *nativeDeadlineTransport) RoundTrip(request *http.Request) (*http.Response, error) {
+	transport.calls++
+	deadline, ok := request.Context().Deadline()
+	expected := 15 * time.Second
+	if transport.operation == "prepare" {
+		expected = 130 * time.Second
+	} else if transport.operation == "accepted" {
+		expected = 60 * time.Second
+	}
+	remaining := time.Until(deadline)
+	if !ok || remaining > expected || remaining < expected-time.Second {
+		transport.t.Errorf("%s request deadline %v; need bounded %v", transport.operation, remaining, expected)
+	}
+	var body map[string]interface{}
+	if err := json.NewDecoder(request.Body).Decode(&body); err != nil {
+		transport.t.Fatal(err)
+	}
+	response := map[string]interface{}{"protocol": body["protocol"], "operation": body["operation"], "request_id": body["request_id"]}
+	raw, _ := json.Marshal(response)
+	return &http.Response{StatusCode: http.StatusOK, Header: http.Header{"Content-Type": []string{"application/json"}}, Body: io.NopCloser(bytes.NewReader(raw))}, nil
+}
