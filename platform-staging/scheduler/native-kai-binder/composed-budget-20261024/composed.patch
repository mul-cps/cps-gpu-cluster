+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "urn:cps:native-qualified-budget-inputs:v1",
+  "title": "Native qualified GPU candidate filter inputs v1",
+  "oneOf": [
+    {
+      "$ref": "#/$defs/budget"
+    },
+    {
+      "$ref": "#/$defs/claims"
