+func TestTwoDistinctUnknownGroupsUseTwoSlotsWithoutDoubleChargingEachDevice(t *testing.T) {
+	f := newFixture()
+	withoutReservations(f)
+	for _, raw := range f.budgetBody["nodes"].([]any)[0].(map[string]any)["devices"].([]any) {
+		d := raw.(map[string]any)
+		d["budget_mib"] = 5120
+		d["max_workspaces"] = 1
+	}
+	f.open(t)
+	statement := f.ssn.Statement()
+	checkpoint := statement.Checkpoint()
+	require.True(t, gpu_sharing.AllocateFractionalGPUTaskToNode(f.ssn, statement, f.tasks[0], f.node, false))
+	first := f.tasks[0].GPUGroupIDs()[0]
+	require.True(t, gpu_sharing.AllocateFractionalGPUTaskToNode(f.ssn, statement, f.tasks[1], f.node, false))
+	second := f.tasks[1].GPUGroupIDs()[0]
+	require.NotEqual(t, first, second)
+	require.False(t, gpu_sharing.AllocateFractionalGPUTaskToNode(f.ssn, statement, f.tasks[2], f.node, false))
+	require.NoError(t, statement.Rollback(checkpoint))
+	require.True(t, gpu_sharing.AllocateFractionalGPUTaskToNode(f.ssn, statement, f.tasks[2], f.node, false))
+}
