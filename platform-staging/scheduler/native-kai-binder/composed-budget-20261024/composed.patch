+func TestRealStatementRollbackRestoresProvisionalCapacityButKeepsRetiringClaims(t *testing.T) {
+	f := newFixture()
+	p := f.open(t)
+	for i := 0; i < 10; i++ {
+		require.Equal(t, []string{"group-b"}, f.ssn.FittingGPUs(f.node, f.tasks[0]))
+	}
+	statement := f.ssn.Statement()
+	checkpoint := statement.Checkpoint()
+	require.True(t, gpu_sharing.AllocateFractionalGPUTaskToNode(f.ssn, statement, f.tasks[0], f.node, false))
+	require.Equal(t, []string{"group-b"}, f.tasks[0].GPUGroupIDs())
+	require.Empty(t, f.ssn.FittingGPUs(f.node, f.tasks[1]))
+	p.changedAllocation(&framework.Event{Task: f.tasks[0]}) // A duplicate event cannot charge twice.
+	require.Empty(t, f.ssn.FittingGPUs(f.node, f.tasks[1]))
+	require.NoError(t, statement.Rollback(checkpoint))
+	require.Equal(t, []string{"group-b"}, f.ssn.FittingGPUs(f.node, f.tasks[1]))
+	require.Equal(t, []string{"group-b"}, f.ssn.FittingGPUs(f.node, f.tasks[0]))
+	// A still has active+retiring native custody even after KAI's rollback.
+	_, err := p.gpuOrder(f.tasks[0], f.node, "group-a")
+	require.Error(t, err)
+}
