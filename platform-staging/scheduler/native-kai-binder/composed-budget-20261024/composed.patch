+)
+
+type nativeHTTPTestCoordinator struct {
+	*nativeTestCoordinator
+	accepted *unstructured.Unstructured
+}
+
+func (c *nativeHTTPTestCoordinator) Prepare(ctx context.Context, s NativeTerminalSnapshot) (NativeAllocationFence, error) {
+	f, err := c.nativeTestCoordinator.Prepare(ctx, s)
+	return &nativeHTTPTestFence{NativeAllocationFence: f, owner: c}, err
+}
+
+type nativeHTTPTestFence struct {
+	NativeAllocationFence
+	owner *nativeHTTPTestCoordinator
+}
+
+func (f *nativeHTTPTestFence) BindingAccepted(ctx context.Context, binding *unstructured.Unstructured) error {
+	f.owner.accepted = binding.DeepCopy()
+	return f.NativeAllocationFence.BindingAccepted(ctx, binding)
+}
+
+func TestNativeBindingRealHTTPTransport(t *testing.T) {
+	for _, outcome := range []string{"success", "forbidden", "lost-response"} {
+		t.Run(outcome, func(t *testing.T) {
+			pod, node, br := nativeTestInputs()
+			for k, v := range nativeTestState().BindingPodAnnotations {
+				pod.Annotations[k] = v
+			}
+			ack := nativeTestACK(pod)
+			coord := &nativeHTTPTestCoordinator{nativeTestCoordinator: &nativeTestCoordinator{ack: ack}}
+			expected := map[string]interface{}{
+				"apiVersion": "v1", "kind": "Binding",
+				"metadata": map[string]interface{}{"namespace": pod.Namespace, "name": pod.Name, "uid": string(pod.UID), "resourceVersion": pod.ResourceVersion},
+				"target":   map[string]interface{}{"kind": "Node", "name": node.Name, "uid": string(node.UID)},
+			}
+			calls := 0
+			var received map[string]interface{}
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				calls++
+				coord.calls = append(coord.calls, "binding")
+				if r.Method != "POST" || r.URL.Path != "/api/v1/namespaces/cps/pods/notebook/binding" {
+					t.Errorf("unexpected request %s %s", r.Method, r.URL.Path)
+					w.WriteHeader(404)
+					return
+				}
+				if !strings.HasPrefix(r.Header.Get("Content-Type"), "application/json") {
+					t.Errorf("Binding must use JSON, got %q", r.Header.Get("Content-Type"))
+				}
+				raw, err := io.ReadAll(r.Body)
+				if err != nil {
+					t.Error(err)
+					return
+				}
+				if err = json.Unmarshal(raw, &received); err != nil {
+					t.Error(err)
+					return
+				}
+				if !reflect.DeepEqual(received, expected) {
+					t.Errorf("Binding wire contract changed: %s", raw)
+				}
+				if outcome == "lost-response" {
+					conn, _, err := w.(http.Hijacker).Hijack()
+					if err != nil {
+						t.Error(err)
+						return
+					}
+					_ = conn.Close()
+					return
+				}
+				w.Header().Set("Content-Type", "application/json")
+				if outcome == "forbidden" {
+					w.WriteHeader(http.StatusForbidden)
+					_ = json.NewEncoder(w).Encode(&metav1.Status{TypeMeta: metav1.TypeMeta{APIVersion: "v1", Kind: "Status"}, Status: "Failure", Reason: metav1.StatusReasonForbidden, Code: 403})
+					return
+				}
+				w.WriteHeader(http.StatusCreated)
+				_ = json.NewEncoder(w).Encode(&metav1.Status{TypeMeta: metav1.TypeMeta{APIVersion: "v1", Kind: "Status"}, Status: "Success", Code: 201})
+			}))
+			defer server.Close()
+			scheme := runtime.NewScheme()
+			if err := v1.AddToScheme(scheme); err != nil {
+				t.Fatal(err)
+			}
+			mapper := meta.NewDefaultRESTMapper([]schema.GroupVersion{v1.SchemeGroupVersion})
+			mapper.Add(v1.SchemeGroupVersion.WithKind("Pod"), meta.RESTScopeNamespace)
+			kube, err := client.New(&rest.Config{Host: server.URL}, client.Options{Scheme: scheme, Mapper: mapper})
+			if err != nil {
+				t.Fatal(err)
+			}
+			reader := nativeTestClient(t, pod, node, br, func(*v1.Binding) error { t.Fatal("fake Binding must not execute"); return nil }, ack)
+			original := pod.DeepCopy()
+			reservation := &nativeTestReservation{}
+			binder := NewBinder(kube, reservation, plugins.New())
+			binder.SetNativeTerminal(reader, "authority", coord)
+			err = binder.bindNativeTerminal(context.Background(), pod, node, br, nativeTestState())
+			if calls != 1 {
+				t.Fatalf("Binding must be attempted exactly once, requests=%d error=%v", calls, err)
+			}
+			if !reflect.DeepEqual(pod, original) {
+				t.Fatal("authenticated original typed Pod changed")
+			}
+			if outcome == "success" {
+				if err != nil {
+					t.Fatal(err)
+				}
+				if coord.accepted == nil || !reflect.DeepEqual(coord.accepted.Object, expected) {
+					t.Fatal("Binding acceptance must use the original approved request, not API Status response")
+				}
+				if !reflect.DeepEqual(coord.calls, []string{"prepare", "validate", "validate-binding", "binding", "bound", "close"}) {
+					t.Fatalf("terminal order changed: %v", coord.calls)
+				}
+			} else {
+				if !errors.Is(err, ErrNativeCustodyHeld) {
+					t.Fatalf("API failure must hold custody: %v", err)
+				}
+				if coord.accepted != nil || !reflect.DeepEqual(coord.calls, []string{"prepare", "validate", "validate-binding", "binding", "hold", "close"}) {
+					t.Fatalf("ambiguous/failed Binding must not be accepted or retried: %v", coord.calls)
+				}
+				if reservation.removed != 0 {
+					t.Fatal("failed Binding released reservation")
+				}
+			}
+		})
+	}
+}
