diff --git a/pkg/scheduler/plugins/nativequalifiedbudget/provider.go b/pkg/scheduler/plugins/nativequalifiedbudget/provider.go
new file mode 100644
index 0000000..6f7a501
--- /dev/null
+++ b/pkg/scheduler/plugins/nativequalifiedbudget/provider.go
@@ -0,0 +1,272 @@
+// Copyright 2026 NVIDIA CORPORATION
+// SPDX-License-Identifier: Apache-2.0
+
+package nativequalifiedbudget
+
+import (
+	"fmt"
+	"strings"
+	"sync/atomic"
+	"time"
+
+	v1 "k8s.io/api/core/v1"
+	"k8s.io/apimachinery/pkg/labels"
+	corelisters "k8s.io/client-go/listers/core/v1"
+	clientcache "k8s.io/client-go/tools/cache"
+
+	"github.com/kai-scheduler/KAI-scheduler/pkg/scheduler/framework"
+)
+
+type versionRef struct{ namespace, name, uid, rv string }
+
+func cmVersion(cm *v1.ConfigMap) versionRef {
+	return versionRef{cm.Namespace, cm.Name, string(cm.UID), cm.ResourceVersion}
+}
+func podVersion(pod *v1.Pod) versionRef {
+	return versionRef{pod.Namespace, pod.Name, string(pod.UID), pod.ResourceVersion}
+}
+func nodeVersion(node *v1.Node) versionRef {
+	return versionRef{name: node.Name, uid: string(node.UID), rv: node.ResourceVersion}
+}
+
+type requestRecord struct {
+	body         *requestDocument
+	ref          versionRef
+	profileLabel string
+}
+type nodeView struct {
+	budget             nodeBudget
+	claims             *claimsDocument
+	claimsRef, nodeRef versionRef
+	err                error
+}
+type handler struct {
+	informer     clientcache.SharedIndexInformer
+	registration clientcache.ResourceEventHandlerRegistration
+}
+type provider struct {
+	opts              options
+	cms               corelisters.ConfigMapLister
+	nodes             corelisters.NodeLister
+	pods              corelisters.PodLister
+	budget            *budgetDocument
+	catalogLabelValue string
+	requests          map[string]requestRecord
+	views             map[string]*nodeView
+	generation        atomic.Uint64
+	initialGeneration uint64
+	handlers          []handler
+	err               error
+}
+
+func protectedMap(cm *v1.ConfigMap, key string, immutable bool) error {
+	if cm == nil || !validUID(string(cm.UID)) || !rvPattern.MatchString(cm.ResourceVersion) || cm.DeletionTimestamp != nil || len(cm.OwnerReferences) > 0 || len(cm.BinaryData) > 0 || len(cm.Data) != 1 {
+		return fmt.Errorf("protected native ConfigMap identity required")
+	}
+	if _, ok := cm.Data[key]; !ok {
+		return fmt.Errorf("closed native ConfigMap payload required")
+	}
+	if immutable && (cm.Immutable == nil || !*cm.Immutable) {
+		return fmt.Errorf("immutable native ConfigMap required")
+	}
+	return nil
+}
+
+func newProvider(ssn *framework.Session, opts options, now time.Time) *provider {
+	p := &provider{opts: opts, requests: map[string]requestRecord{}, views: map[string]*nodeView{}}
+	if ssn.Cache == nil {
+		p.err = fmt.Errorf("trusted informer cache required")
+		return p
+	}
+	factory := ssn.Cache.KubeInformerFactory()
+	if factory == nil {
+		p.err = fmt.Errorf("trusted informer factory required")
+		return p
+	}
+	cmi, ni, pi := factory.Core().V1().ConfigMaps(), factory.Core().V1().Nodes(), factory.Core().V1().Pods()
+	p.cms, p.nodes, p.pods = cmi.Lister(), ni.Lister(), pi.Lister()
+	for _, informer := range []clientcache.SharedIndexInformer{cmi.Informer(), ni.Informer(), pi.Informer()} {
+		if !informer.HasSynced() {
+			p.err = fmt.Errorf("native input informer is not synchronized")
+			p.close()
+			return p
+		}
+		registration, err := informer.AddEventHandler(clientcache.ResourceEventHandlerDetailedFuncs{
+			AddFunc: func(object any, initial bool) {
+				if !initial {
+					p.changed(object)
+				}
+			},
+			UpdateFunc: func(_, current any) { p.changed(current) }, DeleteFunc: p.changed,
+		})
+		if err != nil {
+			p.err = err
+			p.close()
+			return p
+		}
+		p.handlers = append(p.handlers, handler{informer, registration})
+	}
+	p.initialGeneration = p.generation.Load()
+	p.err = p.load(now)
+	if p.err == nil && p.generation.Load() != p.initialGeneration {
+		p.err = fmt.Errorf("native input changed during snapshot")
+	}
+	return p
+}
+
+func (p *provider) changed(object any) {
+	if tombstone, ok := object.(clientcache.DeletedFinalStateUnknown); ok {
+		object = tombstone.Obj
+	}
+	switch item := object.(type) {
+	case *v1.ConfigMap:
+		if item.Namespace == p.opts.requestNS || item.Namespace == p.opts.claimsNS || item.Namespace == p.opts.budget.Namespace && item.Name == p.opts.budget.Name {
+			p.generation.Add(1)
+		}
+	case *v1.Node:
+		p.generation.Add(1)
+	case *v1.Pod:
+		if item.Namespace == p.opts.reservationNS || item.Annotations[marker] != "" {
+			p.generation.Add(1)
+		}
+	}
+}
+
+func (p *provider) close() {
+	for _, h := range p.handlers {
+		_ = h.informer.RemoveEventHandler(h.registration)
+	}
+	p.handlers = nil
+}
+
+func (p *provider) reservationCurrent(ref versionRef, group string) bool {
+	// The binder looks up the group across this entire namespace, not one Node.
+	pods, err := p.pods.Pods(p.opts.reservationNS).List(labels.SelectorFromSet(labels.Set{"runai-gpu-group": group}))
+	return err == nil && len(pods) == 1 && podVersion(pods[0]) == ref && pods[0].DeletionTimestamp == nil
+}
+
+func (p *provider) load(now time.Time) error {
+	cm, err := p.cms.ConfigMaps(p.opts.budget.Namespace).Get(p.opts.budget.Name)
+	if err != nil {
+		return err
+	}
+	cm = cm.DeepCopy()
+	if err := protectedMap(cm, "budget.json", true); err != nil {
+		return err
+	}
+	r := p.opts.budget
+	if string(cm.UID) != r.UID || cm.ResourceVersion != r.RV || canonicalHash(cm.Data) != r.DataSHA {
+		return fmt.Errorf("Root budget identity/data changed")
+	}
+	p.budget, err = parseBudget(cm.Data["budget.json"], p.opts)
+	if err != nil {
+		return err
+	}
+	p.catalogLabelValue = p.budget.Catalog.canonicalHash()[7:39]
+	maps, err := p.cms.ConfigMaps(p.opts.requestNS).List(labels.Everything())
+	if err != nil {
+		return err
+	}
+	if len(maps) > maxRecords {
+		return fmt.Errorf("bounded trusted request namespace required")
+	}
+	attempts := map[string]string{}
+	for _, raw := range maps {
+		if !strings.HasPrefix(raw.Name, "cps-native-pool-request-") {
+			continue
+		}
+		cm := raw.DeepCopy()
+		if err := protectedMap(cm, "request.json", true); err != nil {
+			continue
+		}
+		request, err := parseRequest(cm.Data["request.json"], p.budget)
+		if err != nil || cm.Name != "cps-native-pool-request-"+request.Pod.UID {
+			continue
+		}
+		if previous, ok := attempts[request.Attempt]; ok && previous != request.Pod.UID {
+			return fmt.Errorf("conflicting global native attempt requests")
+		}
+		if _, ok := p.requests[request.Pod.UID]; ok {
+			return fmt.Errorf("conflicting native Pod request identity")
+		}
+		attempts[request.Attempt] = request.Pod.UID
+		p.requests[request.Pod.UID] = requestRecord{body: request, ref: cmVersion(cm), profileLabel: "cps.compute/native-pool-" + canonicalHash(request.Profile)[7:23]}
+	}
+	claimAttempts, claimPods := map[string]claim{}, map[string]claim{}
+	for _, node := range p.budget.Nodes {
+		view := &nodeView{budget: node}
+		p.views[node.Name] = view
+		cm, err := p.cms.ConfigMaps(node.ClaimsRef.Namespace).Get(node.ClaimsRef.Name)
+		if err != nil {
+			view.err = err
+			continue
+		}
+		cm = cm.DeepCopy()
+		if err := protectedMap(cm, "claims.json", false); err != nil {
+			view.err = err
+			continue
+		}
+		if string(cm.UID) != node.ClaimsRef.UID {
+			view.err = fmt.Errorf("Node claims identity changed")
+			continue
+		}
+		view.claimsRef = cmVersion(cm)
+		view.claims, view.err = parseClaims(cm.Data["claims.json"], node, p.opts.budget)
+		if view.err != nil {
+			continue
+		}
+		if !fresh(view.claims, p.opts.maxAge, now) {
+			view.err = fmt.Errorf("Node claims snapshot is stale or future")
+			continue
+		}
+		actual, err := p.nodes.Get(node.Name)
+		if err != nil {
+			view.err = err
+			continue
+		}
+		view.nodeRef = nodeVersion(actual)
+		for _, entry := range view.claims.Claims {
+			if uid, ok := attempts[entry.Attempt]; ok && uid != entry.Pod.UID {
+				return fmt.Errorf("trusted request and retained claim attempt disagree")
+			}
+			if request, ok := p.requests[entry.Pod.UID]; ok && (request.body.Attempt != entry.Attempt || request.body.Pod != entry.Pod || request.body.CapMiB != entry.CapMiB) {
+				return fmt.Errorf("trusted request and retained claim identity/cap disagree")
+			}
+			if previous, ok := claimAttempts[entry.Attempt]; ok && previous != entry {
+				return fmt.Errorf("conflicting retained native attempt claims")
+			}
+			if previous, ok := claimPods[entry.Pod.UID]; ok && previous != entry {
+				return fmt.Errorf("conflicting retained native Pod claims")
+			}
+			claimAttempts[entry.Attempt] = entry
+			claimPods[entry.Pod.UID] = entry
+		}
+	}
+	return nil
+}
+
+func fresh(c *claimsDocument, maxAge time.Duration, now time.Time) bool {
+	return c != nil && !now.Before(c.Issued) && now.Before(c.Expires) && now.Sub(c.Issued) <= maxAge && c.Expires.Sub(c.Issued) <= maxAge
+}
+
+func (p *provider) current(view *nodeView, request requestRecord, pod *v1.Pod, now time.Time) bool {
+	if p.err != nil || view == nil || view.err != nil || p.generation.Load() != p.initialGeneration || !fresh(view.claims, p.opts.maxAge, now) || !now.Before(request.body.Deadline) {
+		return false
+	}
+	budget, err := p.cms.ConfigMaps(p.opts.budget.Namespace).Get(p.opts.budget.Name)
+	if err != nil || string(budget.UID) != p.opts.budget.UID || budget.ResourceVersion != p.opts.budget.RV || budget.DeletionTimestamp != nil {
+		return false
+	}
+	for _, ref := range []versionRef{view.claimsRef, request.ref} {
+		cm, err := p.cms.ConfigMaps(ref.namespace).Get(ref.name)
+		if err != nil || cmVersion(cm) != ref || cm.DeletionTimestamp != nil {
+			return false
+		}
+	}
+	node, err := p.nodes.Get(view.budget.Name)
+	if err != nil || nodeVersion(node) != view.nodeRef || node.DeletionTimestamp != nil {
+		return false
+	}
+	actual, err := p.pods.Pods(pod.Namespace).Get(pod.Name)
+	return err == nil && podVersion(actual) == podVersion(pod) && actual.DeletionTimestamp == nil
+}
