+// Never log arbitrary joined causes: API/client errors can contain private data.
+// Only fixed locally generated diagnostics are exposed; bounded traversal also
+// handles wrapped/joined errors without serializing their outer messages.
+func nativeCustodyReason(err error) string {
+	reasons := map[string]string{
+		"current Pod UID/spec/lifecycle differs":           "pod-current",
+		"current selected Node identity differs":           "node-current",
+		"current BindRequest generation differs":           "bind-request-current",
+		"final binding annotation is not persisted":        "binding-annotations",
+		"exact approved physical GPU UUID required":        "reserved-gpu",
+		"coordinator prepare transport failed":             "prepare-transport",
+		"coordinator hold transport failed":                "hold-transport",
+		"coordinator reservation-delete transport failed":  "reservation-delete-transport",
+		"signed internal service token unavailable":        "service-token-unavailable",
+		"signed projected internal service token required": "service-token-invalid",
+	}
+	pending := []error{err}
+	for checked := 0; len(pending) > 0 && checked < 16; checked++ {
+		current := pending[len(pending)-1]
+		pending = pending[:len(pending)-1]
+		if current == nil {
+			continue
+		}
+		switch wrapped := current.(type) {
+		case interface{ Unwrap() []error }:
+			children := wrapped.Unwrap()
+			for i := len(children) - 1; i >= 0 && len(pending) < 16; i-- {
+				pending = append(pending, children[i])
+			}
+		case interface{ Unwrap() error }:
+			pending = append(pending, wrapped.Unwrap())
+		default:
+			if reason, ok := reasons[current.Error()]; ok {
+				return reason
+			}
+		}
+	}
+	return "unclassified"
+}
