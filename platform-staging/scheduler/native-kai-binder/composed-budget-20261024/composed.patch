@@ -0,0 +1,50 @@
+package app
+
+import (
+	"context"
+	"errors"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestNativeReservationReconciliationRetriesAndStops(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	var calls atomic.Int32
+	released := make(chan struct{})
+	runner := &nativeReservationReconciler{interval: time.Millisecond, sync: func(context.Context) error {
+		n := calls.Add(1)
+		if n == 1 {
+			return errors.New("cleanup proof temporarily unavailable")
+		}
+		if n == 3 {
+			close(released)
+		}
+		return nil
+	}}
+	if !runner.NeedLeaderElection() {
+		t.Fatal("cleanup must run only on the elected binder")
+	}
+	done := make(chan error, 1)
+	go func() { done <- runner.Start(ctx) }()
+	select {
+	case <-released:
+	case <-time.After(2 * time.Second):
+		t.Fatal("cleanup was never retried after hold/error")
+	}
+	cancel()
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("reconciler did not stop")
+	}
+	count := calls.Load()
+	time.Sleep(5 * time.Millisecond)
+	if calls.Load() != count {
+		t.Fatal("cleanup continued after cancellation")
+	}
+}
