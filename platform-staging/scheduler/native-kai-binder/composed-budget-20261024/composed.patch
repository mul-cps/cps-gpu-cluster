+func TestNativeInputsFailClosedWithoutChangingOrdinaryCandidates(t *testing.T) {
+	for _, kind := range []string{"request-missing", "request-owner", "request-mutable", "request-catalog", "request-cap", "request-expired", "request-duplicate-attempt", "claim-stale", "claim-future", "claim-epoch", "claim-conflict", "claim-uid", "node-uid", "node-boot", "node-cordoned", "node-not-ready", "node-inventory", "node-label", "device-duplicate", "profile-incomplete", "reservation-duplicate", "reservation-foreign", "reservation-service-account"} {
+		t.Run(kind, func(t *testing.T) {
+			f := newFixture()
+			switch kind {
+			case "request-missing":
+				f.requests = f.requests[1:]
+			case "request-owner":
+				f.requests[0].OwnerReferences = []metav1.OwnerReference{{UID: types.UID(uid(1))}}
+			case "request-mutable":
+				f.requests[0].Immutable = ptr(false)
+			case "request-catalog", "request-cap", "request-expired", "request-duplicate-attempt":
+				var body map[string]any
+				require.NoError(t, json.Unmarshal([]byte(f.requests[0].Data["request.json"]), &body))
+				if kind == "request-cap" {
+					body["cap_mib"] = 10240
+				} else if kind == "request-expired" {
+					body["authorization_deadline"] = f.now.Format(time.RFC3339Nano)
+				} else if kind == "request-duplicate-attempt" {
+					body["attempt"] = uid(21)
+				} else {
+					body["catalog_ref"].(map[string]any)["uid"] = uid(999)
+				}
+				f.requests[0].Data["request.json"] = encode(body)
+			case "claim-stale":
+				f.claimsBody["issued_at"] = f.now.Add(-time.Minute).Format(time.RFC3339Nano)
+			case "claim-future":
+				f.claimsBody["issued_at"] = f.now.Add(time.Second).Format(time.RFC3339Nano)
+			case "claim-epoch":
+				f.claimsBody["driver_generation"] = uid(999)
+			case "claim-conflict":
+				c := f.claimsBody["claims"].([]any)
+				c[1].(map[string]any)["attempt"] = c[0].(map[string]any)["attempt"]
+			case "claim-uid":
+				f.claims.UID = types.UID(uid(999))
+			case "node-uid":
+				f.node.Node.UID = types.UID(uid(999))
+			case "node-boot":
+				f.node.Node.Status.NodeInfo.BootID = uid(999)
+			case "node-cordoned":
+				f.node.Node.Spec.Unschedulable = true
+			case "node-not-ready":
+				f.node.Node.Status.Conditions[0].Status = v1.ConditionFalse
+			case "node-inventory":
+				f.node.Node.Status.Allocatable["nvidia.com/gpu"] = resource.MustParse("1")
+			case "node-label":
+				for key := range f.node.Node.Labels {
+					if key != "nvidia.com/gpu.memory" {
+						delete(f.node.Node.Labels, key)
+					}
+				}
+			case "device-duplicate":
+				d := f.budgetBody["nodes"].([]any)[0].(map[string]any)["devices"].([]any)
+				d[1].(map[string]any)["gpu_uuid"] = d[0].(map[string]any)["gpu_uuid"]
+			case "profile-incomplete":
+				f.budgetBody["nodes"].([]any)[0].(map[string]any)["devices"].([]any)[0].(map[string]any)["profiles"] = map[string]any{"other-profile": 5120}
+			case "reservation-duplicate":
+				p := f.reservationPods[1].DeepCopy()
+				p.Name = "gpu-reservation-duplicate"
+				p.UID = types.UID(uid(999))
+				f.reservationPods = append(f.reservationPods, p)
+				f.node.PodInfos[common_info.PodID(p.UID)] = pod_info.NewTaskInfo(p, f.node.VectorMap)
+			case "reservation-foreign":
+				f.reservationPods[1].Annotations["run.ai/reserve_for_gpu_index"] = "99"
+			case "reservation-service-account":
+				f.reservationPods[1].Spec.ServiceAccountName = "foreign"
+			}
+			f.open(t)
+			require.Empty(t, f.ssn.FittingGPUs(f.node, f.tasks[0]))
+			delete(f.tasks[0].Pod.Annotations, "cps.compute/native-pool-pending")
+			require.ElementsMatch(t, []string{"group-a", "group-b"}, f.ssn.FittingGPUs(f.node, f.tasks[0]))
+		})
+	}
+}
