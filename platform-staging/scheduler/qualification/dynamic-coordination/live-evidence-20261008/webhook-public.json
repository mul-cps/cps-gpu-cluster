{
  "apiVersion": "admissionregistration.k8s.io/v1",
  "kind": "ValidatingWebhookConfiguration",
  "metadata": {
    "name": "cps-dynamic-coordination-live-20261008-transport"
  },
  "webhooks": [
    {
      "name": "cpu-transport.qa.compute.cps.unileoben.ac.at",
      "admissionReviewVersions": [
        "v1"
      ],
      "sideEffects": "None",
      "failurePolicy": "Fail",
      "matchPolicy": "Exact",
      "timeoutSeconds": 5,
      "namespaceSelector": {
        "matchLabels": {
          "kubernetes.io/metadata.name": "cps-dynamic-admission-coord-live-20261008"
        }
      },
      "matchConditions": [
        {
          "name": "two-exact-cpu-probes-only",
          "expression": "request.name in ['kai-cpu-deny', 'unregistered-map']"
        }
      ],
      "rules": [
        {
          "apiGroups": [
            ""
          ],
          "apiVersions": [
            "v1"
          ],
          "operations": [
            "CREATE"
          ],
          "resources": [
            "pods/binding",
            "configmaps"
          ],
          "scope": "Namespaced"
        }
      ],
      "clientConfig": {
        "caBundle": "",
        "service": {
          "namespace": "cps-dynamic-coordination-live-20261008",
          "name": "generation-fence",
          "path": "/validate",
          "port": 443
        }
      }
    }
  ]
}
