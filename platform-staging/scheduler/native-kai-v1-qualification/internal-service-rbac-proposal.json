[
  {
    "apiVersion": "rbac.authorization.k8s.io/v1",
    "kind": "ClusterRole",
    "metadata": {
      "name": "cps-native-kai-pilot-binder"
    },
    "rules": [
      {
        "nonResourceURLs": [
          "/api/native-kai/v1/prepare",
          "/api/native-kai/v1/current",
          "/api/native-kai/v1/binding",
          "/api/native-kai/v1/accepted",
          "/api/native-kai/v1/close",
          "/api/native-kai/v1/hold",
          "/api/native-kai/v1/cleanup-maps",
          "/api/native-kai/v1/reservation-delete"
        ],
        "verbs": [
          "post"
        ]
      }
    ]
  },
  {
    "apiVersion": "rbac.authorization.k8s.io/v1",
    "kind": "ClusterRoleBinding",
    "metadata": {
      "name": "cps-native-kai-pilot-binder"
    },
    "roleRef": {
      "apiGroup": "rbac.authorization.k8s.io",
      "kind": "ClusterRole",
      "name": "cps-native-kai-pilot-binder"
    },
    "subjects": [
      {
        "kind": "ServiceAccount",
        "name": "binder",
        "namespace": "kai-scheduler"
      }
    ]
  },
  {
    "apiVersion": "rbac.authorization.k8s.io/v1",
    "kind": "ClusterRole",
    "metadata": {
      "name": "cps-native-kai-pilot-hub"
    },
    "rules": [
      {
        "nonResourceURLs": [
          "/internal/native-kai/v1/lease",
          "/internal/native-kai/v1/compile",
          "/internal/native-kai/v1/created"
        ],
        "verbs": [
          "post"
        ]
      }
    ]
  },
  {
    "apiVersion": "rbac.authorization.k8s.io/v1",
    "kind": "ClusterRoleBinding",
    "metadata": {
      "name": "cps-native-kai-pilot-hub"
    },
    "roleRef": {
      "apiGroup": "rbac.authorization.k8s.io",
      "kind": "ClusterRole",
      "name": "cps-native-kai-pilot-hub"
    },
    "subjects": [
      {
        "kind": "ServiceAccount",
        "name": "hub",
        "namespace": "cit-jhub"
      }
    ]
  },
  {
    "apiVersion": "rbac.authorization.k8s.io/v1",
    "kind": "ClusterRole",
    "metadata": {
      "name": "cps-native-kai-pilot-coordinator-auth"
    },
    "rules": [
      {
        "apiGroups": [
          "authentication.k8s.io"
        ],
        "resources": [
          "tokenreviews"
        ],
        "verbs": [
          "create"
        ]
      },
      {
        "apiGroups": [
          "authorization.k8s.io"
        ],
        "resources": [
          "subjectaccessreviews"
        ],
        "verbs": [
          "create"
        ]
      }
    ]
  }
]
