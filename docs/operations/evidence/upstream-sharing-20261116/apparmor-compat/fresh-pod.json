{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "upstream-apparmor-compat-fresh",
    "namespace": "default",
    "labels": {
      "cps.unileoben.ac.at/fixture": "apparmor-compat"
    }
  },
  "spec": {
    "nodeName": "k3s-wk-gpu2",
    "automountServiceAccountToken": false,
    "activeDeadlineSeconds": 180,
    "terminationGracePeriodSeconds": 5,
    "restartPolicy": "Never",
    "tolerations": [
      {
        "operator": "Exists"
      }
    ],
    "securityContext": {
      "runAsUser": 1000,
      "runAsGroup": 1000,
      "runAsNonRoot": true,
      "seccompProfile": {
        "type": "RuntimeDefault"
      },
      "appArmorProfile": {
        "type": "RuntimeDefault"
      }
    },
    "containers": [
      {
        "name": "probe",
        "image": "ghcr.io/mul-cps/cps-ubuntu-release-upgrade@sha256:5030556ecf8cd38fc9acc4676316bd0a3217d1ab10930b75b9dba7106e8f4004",
        "command": [
          "python3",
          "-c",
          "import time; time.sleep(850)"
        ],
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          }
        },
        "resources": {
          "requests": {
            "cpu": "10m",
            "memory": "64Mi"
          },
          "limits": {
            "cpu": "1",
            "memory": "256Mi"
          }
        }
      }
    ]
  }
}