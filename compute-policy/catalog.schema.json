{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compute.cps.unileoben.ac.at/policy/schema/v1",
  "title": "CPS/CIT policy catalog v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "version",
    "profiles",
    "priorities",
    "queues",
    "entitlements",
    "approvedImages",
    "trusted",
    "labels",
    "gpuQualification",
    "compatibility",
    "notebook",
    "courseProviders",
    "artifacts",
    "reservationPolicy",
    "status",
    "queueUnits",
    "workloadScheduling"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "const": "pilot-unqualified"
    },
    "approvedImages": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^\\S+@sha256:[a-f0-9]{64}$"
      }
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "kind",
          "enabled",
          "cpu",
          "memory",
          "gpu",
          "queue",
          "images",
          "maxAgeSeconds",
          "idleSeconds"
        ],
        "properties": {
          "kind": {
            "enum": [
              "interactive",
              "batch"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "cpu": {
            "type": "string"
          },
          "memory": {
            "type": "string"
          },
          "gpu": {
            "type": "object",
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "none",
                  "shared",
                  "exclusive"
                ]
              }
            }
          },
          "images": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "maxAgeSeconds": {
            "type": "integer",
            "minimum": 1
          },
          "idleSeconds": {
            "type": [
              "integer",
              "null"
            ]
          },
          "queue": {
            "enum": [
              "interactive",
              "batch"
            ]
          }
        }
      }
    },
    "priorities": {
      "type": "object"
    },
    "queues": {
      "type": "object"
    },
    "entitlements": {
      "type": "object"
    },
    "trusted": {
      "type": "object",
      "properties": {
        "jobsets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "namespace",
            "serviceAccountName",
            "command",
            "maxWorkers",
            "maxRetries",
            "ttlSecondsAfterFinished",
            "checkpointClaims"
          ],
          "properties": {
            "namespace": {
              "type": "string",
              "minLength": 1
            },
            "serviceAccountName": {
              "type": "string",
              "minLength": 1
            },
            "command": {
              "const": [
                "python"
              ]
            },
            "maxWorkers": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "maxRetries": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "ttlSecondsAfterFinished": {
              "type": "integer",
              "minimum": 60,
              "maximum": 86400
            },
            "checkpointClaims": {
              "type": "object",
              "maxProperties": 128,
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253,
                "pattern": "\\S"
              },
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 253,
                    "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*$"
                  },
                  {
                    "type": "object",
                    "required": [
                      "claimName"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "claimName": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 253,
                        "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*$"
                      },
                      "subPath": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024,
                        "pattern": "^(?!\\.{1,2}(?:/|$))[^/\\\\\\u0000]+(?:/(?!\\.{1,2}(?:/|$))[^/\\\\\\u0000]+)*$"
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "labels": {
      "type": "object"
    },
    "gpuQualification": {
      "type": "object"
    },
    "compatibility": {
      "type": "object"
    },
    "notebook": {
      "type": "object"
    },
    "courseProviders": {
      "type": "object"
    },
    "artifacts": {
      "type": "object"
    },
    "reservationPolicy": {
      "type": "object"
    },
    "queueUnits": {
      "type": "object"
    },
    "workloadScheduling": {
      "const": {
        "interactive": {
          "queue": "cps-interactive",
          "priorityClassName": "cps-homework"
        },
        "batch": {
          "queue": "cps-batch",
          "priorityClassName": "cps-batch"
        }
      }
    },
    "distributedQualification": {
      "type": "object",
      "required": [
        "qualified"
      ],
      "additionalProperties": false,
      "properties": {
        "qualified": {
          "const": false
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "trusted": {
            "required": [
              "jobsets"
            ]
          }
        }
      },
      "then": {
        "required": [
          "distributedQualification"
        ]
      }
    },
    {
      "if": {
        "required": [
          "distributedQualification"
        ]
      },
      "then": {
        "properties": {
          "trusted": {
            "required": [
              "jobsets"
            ]
          }
        }
      }
    }
  ]
}
